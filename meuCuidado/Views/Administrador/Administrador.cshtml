@{
    ViewBag.Title = "Login Administrador";
    Layout = null;
}

<div class="auth-wrapper">
    <div class="auth-card">

        <h1 class="auth-title">Painel Administrativo</h1>

        <p class="auth-subtitle">
            Acesso restrito ao administrador
        </p>

        @if (ViewBag.Erro != null)
        {
            <p class="erro">@ViewBag.Erro</p>
        }

        <form method="post" action="@Url.Action("Login","Administrador")">

            <div class="form-group">
                <label>Usuário</label>
                <input type="text"
                       name="usuario"
                       class="form-control"
                       placeholder="Digite seu usuário"
                       required />
            </div>

            <div class="form-group">
                <label>Senha</label>
                <input type="password"
                       name="senha"
                       class="form-control"
                       placeholder="Digite sua senha"
                       required />
            </div>

            <button type="submit" class="btn-primary-auth">
                Entrar
            </button>

        </form>

    </div>
</div>

<style>

    body {
        background: linear-gradient(135deg,#e6f4f1,#f8fbff);
        font-family: 'Segoe UI',sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #2f6f68;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c8f8b;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-size: 13px;
        color: #4a6f6a;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
        width: 100%;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
            outline: none;
        }

    .btn-primary-auth {
        width: 100%;
        height: 48px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn-primary-auth:hover {
            background: #3da59b;
        }

    .erro {
        color: #dc3545;
        text-align: center;
        margin-bottom: 10px;
        font-size: 14px;
    }
</style>
