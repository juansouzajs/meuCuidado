@model IEnumerable<meuCuidado.Dominio.ViewModels.SolicitacaoProfissionalViewModel>

@{
    ViewBag.Title = "Solicitações de Profissionais";
    Layout = null;
}

<div class="admin-container">
    <h2>Solicitações Pendentes</h2>

    @if (Model != null && Model.Any())
    {
        <div class="cards-grid">
            @foreach (var solicitacao in Model)
            {
                <div class="card solicitacao-card">
                    <div class="card-header">
                        <h3>@solicitacao.Nome</h3>
                        <span class="badge pendente">Pendente</span>
                    </div>

                    <div class="card-body">
                        <p><strong>Email:</strong> @solicitacao.Email</p>
                        <p><strong>Tipo Profissional:</strong> @solicitacao.TipoProfissional</p>
                        <p><strong>Data da Solicitação:</strong> @solicitacao.DataSolicitacao.ToString("dd/MM/yyyy")</p>
                    </div>

                    <div class="card-footer">
                        <a href="@Url.Action("DetalheSolicitacao", "Admin", new { id = solicitacao.Id })"
                           class="btn visualizar">
                            Ver Cadastro
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <p class="vazio">Nenhuma solicitação pendente.</p>
    }
</div>

<style>
    body {
        background-color: #f4f6f9;
        font-family: Arial, sans-serif;
    }

    .admin-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 0 20px;
    }

    h2 {
        font-size: 1.8rem;
        margin-bottom: 30px;
        color: #212529;
    }

    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 24px;
    }

    .card {
        background-color: #fff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .card:hover {
        transform: translateY(-4px);
        box-shadow: 0 14px 40px rgba(0,0,0,0.12);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .card-header h3 {
        font-size: 1.2rem;
        margin: 0;
        color: #343a40;
    }

    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.75rem;
        font-weight: bold;
    }

    .badge.pendente {
        background-color: #fff3cd;
        color: #664d03;
    }

    .card-body p {
        margin: 6px 0;
        font-size: 0.95rem;
        color: #495057;
    }

    .card-footer {
        margin-top: 16px;
        text-align: right;
    }

    .btn.visualizar {
        background-color: #0d6efd;
        color: #fff;
        padding: 10px 16px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 0.9rem;
        transition: background-color 0.2s ease;
    }

    .btn.visualizar:hover {
        background-color: #084298;
    }

    .vazio {
        font-size: 1rem;
        color: #6c757d;
    }

    @@media (max-width: 768px) {
        h2 {
            text-align: center;
        }
    }
</style>
