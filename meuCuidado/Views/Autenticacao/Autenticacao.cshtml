@model meuCuidado.Dominio.ViewModels.AutenticacaoViewModel
@{
    ViewBag.Title = "Autenticação";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="auth-card">

        <h4 class="mb-2">Verificação de Segurança</h4>
        <p class="text-muted mb-4">
            Digite o código de 5 dígitos enviado para você
        </p>

        <p class="small text-info mb-3">@ViewBag.PopupMessage</p>

        <div class="code-inputs mb-4">
            @Html.TextBoxFor(m => m.Codigo1, new { maxlength = "1", @class = "code-box", id = "Codigo1" })
            @Html.TextBoxFor(m => m.Codigo2, new { maxlength = "1", @class = "code-box", id = "Codigo2" })
            @Html.TextBoxFor(m => m.Codigo3, new { maxlength = "1", @class = "code-box", id = "Codigo3" })
            @Html.TextBoxFor(m => m.Codigo4, new { maxlength = "1", @class = "code-box", id = "Codigo4" })
            @Html.TextBoxFor(m => m.Codigo5, new { maxlength = "1", @class = "code-box", id = "Codigo5" })
        </div>

        <input type="hidden" id="email" value="@Model.Email" />

        <button type="button" id="confirmButton" class="btn btn-primary btn-block">
            Confirmar código
        </button>

    </div>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <script>
        $(document).ready(function () {
            showToaster('@ViewBag.ErrorMessage', 'error');
        });
    </script>
}

@if (ViewBag.SuccessMessage != null)
{
    <script>
        $(document).ready(function () {
            showToaster('@ViewBag.SuccessMessage', 'success');
        });
    </script>
}

<style>
    .auth-card {
        background: #ffffff;
        padding: 30px 25px;
        border-radius: 14px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
        text-align: center;
    }

    .auth-card h4 {
        font-weight: 600;
        color: #1f2937;
    }

    .code-inputs {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .code-box {
        width: 52px;
        height: 56px;
        font-size: 22px;
        text-align: center;
        border-radius: 10px;
        border: 1px solid #d1d5db;
        transition: all 0.2s ease;
    }

    .code-box:focus {
        outline: none;
        border-color: #2563eb;
        box-shadow: 0 0 0 3px rgba(37,99,235,0.15);
    }
</style>

<script src="https://ajax.aspnetcdn.com/ajax/jQuery/jquery-3.5.1.min.js"></script>
<script>
    $(document).ready(function () {

        $('#Codigo1').focus();

        $('.code-box').on('input', function () {
            if (this.value.length === 1) {
                $(this).next('.code-box').focus();
            }
        });

        $('.code-box').on('keydown', function (e) {
            if (e.key === 'Backspace' && this.value === '') {
                $(this).prev('.code-box').focus();
            }
        });

        $('#confirmButton').click(function () {

            let viewModel = {
                Codigo1: $('#Codigo1').val(),
                Codigo2: $('#Codigo2').val(),
                Codigo3: $('#Codigo3').val(),
                Codigo4: $('#Codigo4').val(),
                Codigo5: $('#Codigo5').val(),
                Email: $('#email').val()
            };

            $.ajax({
                url: '@Url.Action("ValidarCodigoAutenticacao", "Login")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(viewModel),
                success: function (response) {
                    if (response.success) {
                        window.location.href = response.redirectUrl;
                    } else {
                        showToaster(response.message, 'error');
                    }
                },
                error: function () {
                    showToaster("Erro ao validar o código.", 'error');
                }
            });
        });
    });
</script>
