<div class="farmacia-wrapper">

    <div class="farmacia-header">
        <h2>Farmácias próximas</h2>
        <p>Visualize farmácias perto de você em tempo real</p>
    </div>

    <div class="farmacia-mapa-container">
        <iframe id="mapaFarmacia"
                loading="lazy">
        </iframe>
    </div>

</div>

<script>
    navigator.geolocation.getCurrentPosition(function (position) {

        const lat = position.coords.latitude;
        const lng = position.coords.longitude;

        const mapa = document.getElementById("mapaFarmacia");

        mapa.src = `https://www.google.com/maps?q=farmacia&ll=${lat},${lng}&z=15&output=embed`;

    }, function () {
        document.getElementById("mapaFarmacia").src =
            "https://www.google.com/maps?q=farmacias+perto+de+mim&output=embed";
    });
</script>

<style>
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .farmacia-wrapper {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 15px;
    }

    /* CARD PADRÃO DO SISTEMA */
    .farmacia-mapa-container {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    /* HEADER */
    .farmacia-header {
        margin-bottom: 20px;
    }

        .farmacia-header h2 {
            font-size: 26px;
            font-weight: 600;
            color: #2f6f68;
            margin-bottom: 5px;
        }

        .farmacia-header p {
            color: #6c8f8b;
            font-size: 14px;
        }

    /* MAPA */
    #mapaFarmacia {
        width: 100%;
        height: 420px;
        border: none;
        border-radius: 12px;
        transition: all 0.2s ease;
    }

        #mapaFarmacia:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 35px rgba(0,0,0,0.12);
        }

    /* RESPONSIVO */
    @@media (max-width: 768px) {
        #mapaFarmacia {
            height: 300px;
        }
    }
</style>