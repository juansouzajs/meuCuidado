            font-size: 12px;
        }

        .rule.valid {
            color: #28a745;
        }

        .rule.invalid {
            color: #b7b7b7;
        }

        .rule.valid i::before {
            content: "\f058";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
        }

        .rule.invalid i::before {
            content: "\f111";
            font-family: "Font Awesome 6 Free";
            font-weight: 900;
        }

    .privacy-consent {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        margin: 18px 0;
        font-size: 13px;
        color: #555;
    }

        .privacy-consent input {
            margin-top: 3px;
            cursor: pointer;
        }

        .privacy-consent a {
            color: #4db6ac;
            font-weight: 600;
            text-decoration: none;
        }

            .privacy-consent a:hover {
                text-decoration: underline;
            }

    .modal-politica {
        width: 95%;
        max-width: 800px;
        max-height: 85vh;
