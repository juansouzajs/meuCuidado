@using meuCuidado.Dominio.Extensions
@model meuCuidado.Dominio.ViewModels.CadastroViewModel

@{
    ViewBag.Title = "Cadastro";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="auth-wrapper">
    <div class="auth-card">

        <h1 class="auth-title">Criar conta</h1>

        <p class="auth-subtitle">
            Cuidar é um ato de amor. Comece seu cadastro 💚
        </p>

        @using (Html.BeginForm())
        {
            <!-- EMAIL PRIMEIRO -->

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Email)

                @Html.TextBoxFor(
                    m => m.Usuario.Email,
                    new
                    {
                        @class = "form-control",
                        id = "email",
                        placeholder = "email@exemplo.com",
                        autocomplete = "off"
                    })

                <span id="emailMensagem" class="text-danger"></span>

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Nome)

                @Html.TextBoxFor(
                    m => m.Usuario.Nome,
                    new
                    {
                        @class = "form-control",
                        id = "nome",
                        placeholder = "Nome completo"
                    })

                @Html.ValidationMessageFor(
                    m => m.Usuario.Nome,
                    "",
                    new { @class = "text-danger" })

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Endereco)

                @Html.TextBoxFor(
                    m => m.Usuario.Endereco,
                    new
                    {
                        @class = "form-control",
                        id = "endereco",
                        placeholder = "Endereço"
                    })

            </div>

            <div class="form-group">

                @Html.Label("Telefone")

                @Html.TextBoxFor(
                    m => m.Usuario.Telefone,
                    new
                    {
                        @class = "form-control",
                        id = "telefone",
                        value = "+55 ",
                        placeholder = "+55 (XX) XXXXX-XXXX",
                        type = "tel"
                    })

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Senha)

                @Html.PasswordFor(
                    m => m.Usuario.Senha,
                    new
                    {
                        @class = "form-control",
                        id = "senha",
                        placeholder = "Crie uma senha segura"
                    })

                <span id="senhaMensagem" class="text-danger"></span>

            </div>


            <div class="form-group">

                @Html.Label("Confirmar Senha")

                @Html.PasswordFor(
                    m => m.ConfirmarSenha,
                    new
                    {
                        @class = "form-control",
                        id = "confirmarSenha",
                        placeholder = "Repita sua senha"
                    })

                <span id="confirmarMensagem" class="text-danger"></span>

            </div>

            <div class="password-rules">

                <h4>Requisitos da senha</h4>

                <div id="rule-length" class="rule">
                    <i class="fas fa-circle"></i>
                    Mínimo de 8 caracteres
                </div>

                <div id="rule-upper" class="rule">
                    <i class="fas fa-circle"></i>
                    Pelo menos 1 letra maiúscula
                </div>

                <div id="rule-lower" class="rule">
                    <i class="fas fa-circle"></i>
                    Pelo menos 1 letra minúscula
                </div>

                <div id="rule-number" class="rule">
                    <i class="fas fa-circle"></i>
                    Pelo menos 1 número
                </div>

                <div id="rule-special" class="rule">
                    <i class="fas fa-circle"></i>
                    Pelo menos 1 caractere especial
                </div>

                <div id="rule-match" class="rule">
                    <i class="fas fa-circle"></i>
                    Senhas coincidem
                </div>

            </div>

            <div class="form-group">

                @Html.Label("Tipo de Usuário")

                @Html.DropDownListFor(
                    m => m.TipoUsuario,
                    new SelectList(
                        EnumExtension.ToSelectList<EnumExtension.TipoUsuario>(),
                        "Value",
                        "Text"),
                    "Selecione",
                    new
                    {
                        @class = "form-control",
                        id = "tipoUsuario"
                    })

            </div>

            <div class="privacy-consent">

                <input type="checkbox"
                       id="aceitaPolitica" />

                <label for="aceitaPolitica">

                    Ao se cadastrar você concorda com a nossa

                    <a href="javascript:void(0)"
                       id="abrirPolitica">

                        Política de Privacidade

                    </a>

                </label>

            </div>

            <button type="submit"
                    id="btnCadastrar"
                    class="btn-primary-auth"
                    disabled>

                Criar conta

            </button>
        }

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="social-login">

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })"
               class="btn-social google">

                Entrar com Google

            </a>

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })"
               class="btn-social facebook">

                Entrar com Facebook

            </a>

        </div>

        <p class="auth-footer">

            Já tem uma conta?

            <a href="@Url.Action("Login", "Login")">
                Entrar
            </a>

        </p>

    </div>
</div>

<!-- MODAL EMAIL -->

<div id="emailModal" class="modal-overlay">

    <div class="modal-box">

        <h2>Email já cadastrado</h2>

        <p>
            Já existe uma conta com este email.
            Deseja ir para a tela de login?
        </p>

        <div class="modal-actions">

            <button id="btnIrLogin"
                    type="button"
                    class="btn-modal-primary">

                Ir para login

            </button>

            <button id="btnContinuar"
                    type="button"
                    class="btn-modal-secondary">

                Continuar aqui

            </button>

        </div>

    </div>

</div>

<!-- MODAL REAPROVEITAR -->

<div id="modalReaproveitar" class="modal-overlay">

    <div class="modal-box">

        <h2>Cadastro anteriormente reprovado</h2>

        <p>
            Encontramos um cadastro reprovado com este email.
            Deseja reaproveitar os dados anteriores?
        </p>

        <div class="modal-actions">

            <button id="btnReaproveitar"
                    type="button"
                    class="btn-modal-primary">

                Sim

            </button>

            <button id="btnNaoReaproveitar"
                    type="button"
                    class="btn-modal-secondary">

                Não

            </button>

        </div>

    </div>

</div>

<div id="modalPolitica" class="modal-overlay">

    <div class="modal-politica">

        <div class="modal-politica-header">

            <h2>
                Política de Privacidade
            </h2>

            <button type="button"
                    id="fecharPolitica">
                ×
            </button>

        </div>

        <div class="modal-politica-body">

            <h3>1. Compromisso com sua privacidade</h3>

            <p>
                O MeuCuidado respeita a sua privacidade e trata
                seus dados pessoais com responsabilidade,
                transparência e segurança.
            </p>

            <h3>2. Dados coletados</h3>

            <p>
                Coletamos apenas as informações estritamente
                necessárias para o funcionamento da plataforma,
                como nome, email, telefone, endereço e demais
                dados necessários para identificação,
                autenticação e conexão entre usuários.
            </p>

            <h3>3. Finalidade do tratamento</h3>

            <p>
                Os dados são utilizados exclusivamente para
                possibilitar o uso dos serviços do MeuCuidado,
                melhorar a experiência do usuário,
                garantir segurança e cumprir obrigações legais.
            </p>

            <h3>4. LGPD</h3>

            <p>
                O MeuCuidado está comprometido com os princípios
                da Lei Geral de Proteção de Dados (Lei nº 13.709/2018 - LGPD),
                adotando medidas técnicas e administrativas para proteger
                seus dados pessoais contra acessos não autorizados,
                perda, alteração ou divulgação indevida.
            </p>

            <p>
                Você possui direito de solicitar acesso,
                correção, atualização, anonimização,
                exclusão ou portabilidade dos seus dados,
                conforme previsto na legislação vigente.
            </p>

            <h3>5. Compartilhamento</h3>

            <p>
                Seus dados não são vendidos ou compartilhados
                com terceiros sem fundamento legal,
                consentimento ou necessidade operacional
                relacionada aos serviços prestados.
            </p>

            <h3>6. Segurança</h3>

            <p>
                Utilizamos mecanismos de segurança para proteger
                as informações armazenadas em nossos sistemas.
            </p>

            <h3>7. Contato</h3>

            <p>
                Em caso de dúvidas sobre privacidade e proteção
                de dados, entre em contato com nossa equipe
                de suporte.
            </p>

        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const aceitaPolitica =
            document.getElementById("aceitaPolitica");

    const telefone = document.getElementById("telefone");
    const senha = document.getElementById("senha");
    const confirmar = document.getElementById("confirmarSenha");
    const email = document.getElementById("email");

    const nome = document.getElementById("nome");
    const endereco = document.getElementById("endereco");

    const msgSenha = document.getElementById("senhaMensagem");
    const msgConfirmar = document.getElementById("confirmarMensagem");
    const msgEmail = document.getElementById("emailMensagem");

    const botao = document.getElementById("btnCadastrar");

    const PREFIX = "+55 ";

    let emailExiste = false;
    let dadosReprovados = null;

    // TELEFONE

    if (telefone && !telefone.value.startsWith(PREFIX)) {
        telefone.value = PREFIX;
    }

    telefone.addEventListener("input", function () {

        if (!telefone.value.startsWith(PREFIX)) {
            telefone.value = PREFIX;
        }

        let digits = telefone.value
            .substring(PREFIX.length)
            .replace(/\D/g, "");

        if (digits.length > 11) {
            digits = digits.substring(0, 11);
        }

        let result = PREFIX;

        if (digits.length > 2) {

            result += "(" + digits.substring(0, 2) + ") ";

            digits = digits.substring(2);
        }
        else {

            result += digits;

            telefone.value = result;

            return;
        }

        if (digits.length <= 4) {

            result += digits;
        }
        else if (digits.length <= 8) {

            result +=
                digits.substring(0, 4) +
                "-" +
                digits.substring(4);
        }
        else {

            result +=
                digits.substring(0, 5) +
                "-" +
                digits.substring(5);
        }

        telefone.value = result;
    });

    // MODAIS

    function abrirModalEmail() {

        document.getElementById("emailModal")
            .style.display = "flex";
    }

    function fecharModalEmail() {

        document.getElementById("emailModal")
            .style.display = "none";
    }

    function abrirModalReaproveitar() {

        document.getElementById("modalReaproveitar")
            .style.display = "flex";
    }

    function fecharModalReaproveitar() {

        document.getElementById("modalReaproveitar")
            .style.display = "none";
    }

    // BOTÕES

    document.getElementById("btnIrLogin")
        .onclick = function () {

        window.location.href =
            '@Url.Action("Login","Login")';
    };

    document.getElementById("btnContinuar")
        .onclick = function () {

        fecharModalEmail();
    };

    document.getElementById("btnNaoReaproveitar")
        .onclick = function () {

        fecharModalReaproveitar();
    };

    document.getElementById("btnReaproveitar")
        .onclick = function () {

        if (!dadosReprovados)
            return;

        nome.value =
            dadosReprovados.nome || "";

        email.value =
            dadosReprovados.email || "";

        endereco.value =
            dadosReprovados.endereco || "";

        telefone.value =
            dadosReprovados.telefone || "+55 ";

        fecharModalReaproveitar();

        msgEmail.textContent =
            "Cadastro reprovado encontrado. Atualize os dados e envie novamente.";

        email.classList.remove("input-invalido");


        validarFormulario();
    };

    // VALIDAÇÕES

        function validarSenhaForte(valor) {

            const min =
                valor.length >= 8;

            const upper =
                /[A-Z]/.test(valor);

            const lower =
                /[a-z]/.test(valor);

            const number =
                /[0-9]/.test(valor);

            const special =
                /[^A-Za-z0-9]/.test(valor);

            atualizarRegra("rule-length", min);
            atualizarRegra("rule-upper", upper);
            atualizarRegra("rule-lower", lower);
            atualizarRegra("rule-number", number);
            atualizarRegra("rule-special", special);

            return min &&
                upper &&
                lower &&
                number &&
                special;
        }

        function atualizarRegra(id, valido) {

            const elemento =
                document.getElementById(id);

            if (!elemento)
                return;

            elemento.classList.remove(
                "valid",
                "invalid"
            );

            elemento.classList.add(
                valido ? "valid" : "invalid"
            );
        }

    function validarEmail(valor) {

        const regex =
            /^[^\s@@]+@@[^\s@@]+\.(com|com\.br|gov)$/;

        return regex.test(valor);
    }

    function verificarEmail(emailDigitado) {

        $.ajax({

            url:
                '@Url.Action("VerificarEmail","Cadastro")',

            type: 'POST',

            data: {
                email: emailDigitado
            },

            success: function (response) {

                if (response.existe) {

                    emailExiste = true;

                    msgEmail.textContent =
                        "Este email já está cadastrado.";

                    email.classList.add("input-invalido");

                    abrirModalEmail();

                    validarFormulario();

                    return;
                }

                if (response.reprovado) {

                    emailExiste = false;

                    dadosReprovados = response.usuario;

                    abrirModalReaproveitar();

                    validarFormulario();

                    return;
                }

                emailExiste = false;

                dadosReprovados = null;

                msgEmail.textContent = "";

                validarFormulario();
            }
        });
    }

    function validarFormulario() {

        const s = senha.value;
        const c = confirmar.value;
        const e = email.value;

        const senhaValida =
            validarSenhaForte(s);

        const senhasIguais =
            s === c &&
            s.length > 0;

        atualizarRegra(
            "rule-match",
            senhasIguais
        );

        const emailValido =
            validarEmail(e);


        // CONFIRMAR

        if (!senhasIguais) {

            msgConfirmar.textContent =
                "As senhas não conferem.";
        }
        else {

            msgConfirmar.textContent = "";
        }

        // EMAIL

        if (!emailValido) {

            msgEmail.textContent =
                "Digite um email válido (.com, .com.br ou .gov)";

            email.classList.add("input-invalido");

            email.classList.remove("input-valido");
        }
        else {

            if (!emailExiste) {

                email.classList.remove("input-invalido");

                email.classList.add("input-valido");
            }
        }

        botao.disabled =
            !(senhaValida
                && senhasIguais
                && emailValido
                && aceitaPolitica.checked)
            || emailExiste;
    }

    // EVENTOS

    senha.addEventListener("input", validarFormulario);

    confirmar.addEventListener("input", validarFormulario);

    email.addEventListener("input", function () {

        emailExiste = false;

        dadosReprovados = null;

        validarFormulario();
    });

    email.addEventListener("blur", function () {

        const valor = email.value;

        if (validarEmail(valor)) {

            verificarEmail(valor);
        }
    });

        [
            "rule-length",
            "rule-upper",
            "rule-lower",
            "rule-number",
            "rule-special",
            "rule-match"
        ].forEach(id =>
            atualizarRegra(id, false)
        );

        validarFormulario();

        aceitaPolitica.addEventListener(
            "change",
            validarFormulario
        );

        document
            .getElementById("abrirPolitica")
            .addEventListener("click", function () {

                document
                    .getElementById("modalPolitica")
                    .style.display = "flex";
            });

        document
            .getElementById("fecharPolitica")
            .addEventListener("click", function () {

                document
                    .getElementById("modalPolitica")
                    .style.display = "none";
            });

});

</script>


<style>

    .password-rules {
        background: #f4f7f7;
        border-left: 4px solid #4db6ac;
        border-radius: 14px;
        padding: 18px;
        margin-top: 10px;
        margin-bottom: 20px;
    }

