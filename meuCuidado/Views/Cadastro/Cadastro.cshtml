@using meuCuidado.Dominio.Extensions
@model meuCuidado.Dominio.ViewModels.CadastroViewModel

@{
    ViewBag.Title = "Cadastro";
}

<div class="auth-wrapper">
    <div class="auth-card">

        <h1 class="auth-title">Criar conta</h1>

        <p class="auth-subtitle">
            Cuidar é um ato de amor. Comece seu cadastro 💚
        </p>

        @using (Html.BeginForm())
        {
            <!-- EMAIL PRIMEIRO -->

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Email)

                @Html.TextBoxFor(
                    m => m.Usuario.Email,
                    new
                    {
                        @class = "form-control",
                        id = "email",
                        placeholder = "email@exemplo.com",
                        autocomplete = "off"
                    })

                <span id="emailMensagem" class="text-danger"></span>

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Nome)

                @Html.TextBoxFor(
                    m => m.Usuario.Nome,
                    new
                    {
                        @class = "form-control",
                        id = "nome",
                        placeholder = "Nome completo"
                    })

                @Html.ValidationMessageFor(
                    m => m.Usuario.Nome,
                    "",
                    new { @class = "text-danger" })

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Endereco)

                @Html.TextBoxFor(
                    m => m.Usuario.Endereco,
                    new
                    {
                        @class = "form-control",
                        id = "endereco",
                        placeholder = "Endereço"
                    })

            </div>

            <div class="form-group">

                @Html.Label("Telefone")

                @Html.TextBoxFor(
                    m => m.Usuario.Telefone,
                    new
                    {
                        @class = "form-control",
                        id = "telefone",
                        value = "+55 ",
                        placeholder = "+55 (XX) XXXXX-XXXX",
                        type = "tel"
                    })

            </div>

            <div class="form-group">

                @Html.LabelFor(m => m.Usuario.Senha)

                @Html.PasswordFor(
                    m => m.Usuario.Senha,
                    new
                    {
                        @class = "form-control",
                        id = "senha",
                        placeholder = "Crie uma senha segura"
                    })

                <span id="senhaMensagem" class="text-danger"></span>

            </div>

            <div class="form-group">

                @Html.Label("Confirmar Senha")

                @Html.PasswordFor(
                    m => m.ConfirmarSenha,
                    new
                    {
                        @class = "form-control",
                        id = "confirmarSenha",
                        placeholder = "Repita sua senha"
                    })

                <span id="confirmarMensagem" class="text-danger"></span>

            </div>

            <div class="form-group">

                @Html.Label("Tipo de Usuário")

                @Html.DropDownListFor(
                    m => m.TipoUsuario,
                    new SelectList(
                        EnumExtension.ToSelectList<EnumExtension.TipoUsuario>(),
                        "Value",
                        "Text"),
                    "Selecione",
                    new
                    {
                        @class = "form-control",
                        id = "tipoUsuario"
                    })

            </div>

            <button type="submit"
                    id="btnCadastrar"
                    class="btn-primary-auth">

                Criar conta

            </button>
        }

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="social-login">

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })"
               class="btn-social google">

                Entrar com Google

            </a>

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })"
               class="btn-social facebook">

                Entrar com Facebook

            </a>

        </div>

        <p class="auth-footer">

            Já tem uma conta?

            <a href="@Url.Action("Login", "Login")">
                Entrar
            </a>

        </p>

    </div>
</div>

<!-- MODAL EMAIL -->

<div id="emailModal" class="modal-overlay">

    <div class="modal-box">

        <h2>Email já cadastrado</h2>

        <p>
            Já existe uma conta com este email.
            Deseja ir para a tela de login?
        </p>

        <div class="modal-actions">

            <button id="btnIrLogin"
                    type="button"
                    class="btn-modal-primary">

                Ir para login

            </button>

            <button id="btnContinuar"
                    type="button"
                    class="btn-modal-secondary">

                Continuar aqui

            </button>

        </div>

    </div>

</div>

<!-- MODAL REAPROVEITAR -->

<div id="modalReaproveitar" class="modal-overlay">

    <div class="modal-box">

        <h2>Cadastro anteriormente reprovado</h2>

        <p>
            Encontramos um cadastro reprovado com este email.
            Deseja reaproveitar os dados anteriores?
        </p>

        <div class="modal-actions">

            <button id="btnReaproveitar"
                    type="button"
                    class="btn-modal-primary">

                Sim

            </button>

            <button id="btnNaoReaproveitar"
                    type="button"
                    class="btn-modal-secondary">

                Não

            </button>

        </div>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

document.addEventListener("DOMContentLoaded", function () {

    const telefone = document.getElementById("telefone");
    const senha = document.getElementById("senha");
    const confirmar = document.getElementById("confirmarSenha");
    const email = document.getElementById("email");

    const nome = document.getElementById("nome");
    const endereco = document.getElementById("endereco");

    const msgSenha = document.getElementById("senhaMensagem");
    const msgConfirmar = document.getElementById("confirmarMensagem");
    const msgEmail = document.getElementById("emailMensagem");

    const botao = document.getElementById("btnCadastrar");

    const PREFIX = "+55 ";

    let emailExiste = false;
    let dadosReprovados = null;

    // TELEFONE

    if (telefone && !telefone.value.startsWith(PREFIX)) {
        telefone.value = PREFIX;
    }

    telefone.addEventListener("input", function () {

        if (!telefone.value.startsWith(PREFIX)) {
            telefone.value = PREFIX;
        }

        let digits = telefone.value
            .substring(PREFIX.length)
            .replace(/\D/g, "");

        if (digits.length > 11) {
            digits = digits.substring(0, 11);
        }

        let result = PREFIX;

        if (digits.length > 2) {

            result += "(" + digits.substring(0, 2) + ") ";

            digits = digits.substring(2);
        }
        else {

            result += digits;

            telefone.value = result;

            return;
        }

        if (digits.length <= 4) {

            result += digits;
        }
        else if (digits.length <= 8) {

            result +=
                digits.substring(0, 4) +
                "-" +
                digits.substring(4);
        }
        else {

            result +=
                digits.substring(0, 5) +
                "-" +
                digits.substring(5);
        }

        telefone.value = result;
    });

    // MODAIS

    function abrirModalEmail() {

        document.getElementById("emailModal")
            .style.display = "flex";
    }

    function fecharModalEmail() {

        document.getElementById("emailModal")
            .style.display = "none";
    }

    function abrirModalReaproveitar() {

        document.getElementById("modalReaproveitar")
            .style.display = "flex";
    }

    function fecharModalReaproveitar() {

        document.getElementById("modalReaproveitar")
            .style.display = "none";
    }

    // BOTÕES

    document.getElementById("btnIrLogin")
        .onclick = function () {

        window.location.href =
            '@Url.Action("Login","Login")';
    };

    document.getElementById("btnContinuar")
        .onclick = function () {

        fecharModalEmail();
    };

    document.getElementById("btnNaoReaproveitar")
        .onclick = function () {

        fecharModalReaproveitar();
    };

    document.getElementById("btnReaproveitar")
        .onclick = function () {

        if (!dadosReprovados)
            return;

        nome.value =
            dadosReprovados.nome || "";

        email.value =
            dadosReprovados.email || "";

        endereco.value =
            dadosReprovados.endereco || "";

        telefone.value =
            dadosReprovados.telefone || "+55 ";

        fecharModalReaproveitar();

        msgEmail.textContent =
            "Cadastro reprovado encontrado. Atualize os dados e envie novamente.";

        email.classList.remove("input-invalido");

        validarFormulario();
    };

    // VALIDAÇÕES

    function validarSenhaForte(valor) {

        const min = valor.length >= 6;
        const letra = /[A-Za-z]/.test(valor);
        const numero = /[0-9]/.test(valor);

        return min && letra && numero;
    }

    function validarEmail(valor) {

        const regex =
            /^[^\s@@]+@@[^\s@@]+\.(com|com\.br|gov)$/;

        return regex.test(valor);
    }

    function verificarEmail(emailDigitado) {

        $.ajax({

            url:
                '@Url.Action("VerificarEmail","Cadastro")',

            type: 'POST',

            data: {
                email: emailDigitado
            },

            success: function (response) {

                if (response.existe) {

                    emailExiste = true;

                    msgEmail.textContent =
                        "Este email já está cadastrado.";

                    email.classList.add("input-invalido");

                    abrirModalEmail();

                    validarFormulario();

                    return;
                }

                if (response.reprovado) {

                    emailExiste = false;

                    dadosReprovados = response.usuario;

                    abrirModalReaproveitar();

                    validarFormulario();

                    return;
                }

                emailExiste = false;

                dadosReprovados = null;

                msgEmail.textContent = "";

                validarFormulario();
            }
        });
    }

    function validarFormulario() {

        const s = senha.value;
        const c = confirmar.value;
        const e = email.value;

        const senhaValida =
            validarSenhaForte(s);

        const senhasIguais =
            s === c && s.length > 0;

        const emailValido =
            validarEmail(e);

        // SENHA

        if (!senhaValida) {

            msgSenha.textContent =
                "A senha deve ter pelo menos 6 caracteres, letras e números.";
        }
        else {

            msgSenha.textContent = "";
        }

        // CONFIRMAR

        if (!senhasIguais) {

            msgConfirmar.textContent =
                "As senhas não conferem.";
        }
        else {

            msgConfirmar.textContent = "";
        }

        // EMAIL

        if (!emailValido) {

            msgEmail.textContent =
                "Digite um email válido (.com, .com.br ou .gov)";

            email.classList.add("input-invalido");

            email.classList.remove("input-valido");
        }
        else {

            if (!emailExiste) {

                email.classList.remove("input-invalido");

                email.classList.add("input-valido");
            }
        }

        botao.disabled =
            !(senhaValida && senhasIguais && emailValido)
            || emailExiste;
    }

    // EVENTOS

    senha.addEventListener("input", validarFormulario);

    confirmar.addEventListener("input", validarFormulario);

    email.addEventListener("input", function () {

        emailExiste = false;

        dadosReprovados = null;

        validarFormulario();
    });

    email.addEventListener("blur", function () {

        const valor = email.value;

        if (validarEmail(valor)) {

            verificarEmail(valor);
        }
    });

    validarFormulario();

});

</script>


<style>

    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 999;
    }

    .modal-box {
        background: white;
        padding: 30px;
        border-radius: 16px;
        width: 100%;
        max-width: 380px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .btn-modal-primary {
        flex: 1;
        height: 40px;
        border: none;
        border-radius: 10px;
        background: #4db6ac;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-modal-secondary {
        flex: 1;
        height: 40px;
        border-radius: 10px;
        border: 1px solid #ccc;
        background: white;
        cursor: pointer;
    }

    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #2f6f68;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c8f8b;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-size: 13px;
        color: #4a6f6a;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    .input-invalido {
        border-color: #dc3545 !important;
    }

    .input-valido {
        border-color: #2e7d32 !important;
    }

    .btn-primary-auth {
        width: 100%;
        height: 48px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn-primary-auth:hover {
            background: #3da59b;
        }

        .btn-primary-auth:disabled {
            background: #a0cfc9;
            cursor: not-allowed;
        }

    .divider {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

        .divider span {
            background: white;
            padding: 0 10px;
            color: #9aa;
            font-size: 13px;
        }

        .divider::before {
            content: "";
            height: 1px;
            background: #e0e0e0;
            width: 100%;
            position: absolute;
            top: 50%;
            left: 0;
            z-index: -1;
        }

    .social-login {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-social {
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .btn-social.google {
            border: 1px solid #db4437;
            color: #db4437;
        }

        .btn-social.facebook {
            border: 1px solid #3b5998;
            color: #3b5998;
        }

        .btn-social:hover {
            opacity: 0.85;
        }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
    }

        .auth-footer a {
            color: #4db6ac;
            font-weight: 600;
            text-decoration: none;
        }
</style>
