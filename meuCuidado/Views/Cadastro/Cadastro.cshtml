        justify-content: center;
        z-index: 999;
    }

    .modal-box {
        background: white;
        padding: 30px;
        border-radius: 16px;
        width: 100%;
        max-width: 380px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    .modal-actions {
        display: flex;
        gap: 10px;
    }

    .btn-modal-primary {
        flex: 1;
        height: 40px;
        border: none;
        border-radius: 10px;
        background: #4db6ac;
        color: white;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-modal-secondary {
        flex: 1;
        height: 40px;
        border-radius: 10px;
        border: 1px solid #ccc;
