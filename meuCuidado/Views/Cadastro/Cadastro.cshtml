@using meuCuidado.Dominio.Extensions
@model meuCuidado.Dominio.ViewModels.CadastroViewModel

@{
    ViewBag.Title = "Cadastro";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Criar conta</h1>
        <p class="auth-subtitle">
            Cuidar é um ato de amor. Comece seu cadastro 💚
        </p>

        @using (Html.BeginForm())
        {
            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.Nome)
                @Html.TextBoxFor(m => m.Usuario.Nome, new { @class = "form-control", placeholder = "Nome completo" })
                @Html.ValidationMessageFor(m => m.Usuario.Nome, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.Endereco)
                @Html.TextBoxFor(m => m.Usuario.Endereco, new { @class = "form-control", placeholder = "Endereço" })
            </div>

            <div class="form-group">
                @Html.Label("Telefone")
                @Html.TextBoxFor(
                    m => m.Usuario.Telefone,
                    new
                    {
                        @class = "form-control",
                        @id = "telefone",
                        value = "+55 ",
                        placeholder = "+55 (XX) XXXXX-XXXX",
                        type = "tel"
                    })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.Email)
                @Html.TextBoxFor(m => m.Usuario.Email, new { @class = "form-control", placeholder = "email@exemplo.com" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.Senha)
                @Html.PasswordFor(m => m.Usuario.Senha, new
                {
                    @class = "form-control",
                    id = "senha",
                    placeholder = "Crie uma senha segura"
                })
                <span id="senhaMensagem" class="text-danger"></span>
            </div>

            <div class="form-group">
                @Html.Label("Confirmar Senha")
                @Html.PasswordFor(m => m.ConfirmarSenha, new
                {
                    @class = "form-control",
                    id = "confirmarSenha",
                    placeholder = "Repita sua senha"
                })
                <span id="confirmarMensagem" class="text-danger"></span>
            </div>

            <div class="form-group">
                @Html.Label("Tipo de Usuário")
                @Html.DropDownListFor(
                    m => m.TipoUsuario,
                    new SelectList(EnumExtension.ToSelectList<EnumExtension.TipoUsuario>(), "Value", "Text"),
                    "Selecione",
                    new { @class = "form-control" }
                )
            </div>

            <button type="submit" id="btnCadastrar" class="btn-primary-auth">
                Criar conta
            </button>
        }

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="social-login">
            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })" class="btn-social google">
                Entrar com Google
            </a>

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })" class="btn-social facebook">
                Entrar com Facebook
            </a>
        </div>

        <p class="auth-footer">
            Já tem uma conta?
            <a href="@Url.Action("Login", "Login")">Entrar</a>
        </p>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        // ======== MÁSCARA DE TELEFONE (SEU CÓDIGO ORIGINAL) ========
        const input = document.getElementById("telefone");
        if (input) {
            const PREFIX = "+55 ";

            if (!input.value.startsWith(PREFIX)) {
                input.value = PREFIX;
            }

            input.addEventListener("input", function () {
                if (!input.value.startsWith(PREFIX)) {
                    input.value = PREFIX;
                }

                let digits = input.value.substring(PREFIX.length).replace(/\D/g, "");

                if (digits.length > 11) {
                    digits = digits.substring(0, 11);
                }

                let result = PREFIX;

                if (digits.length > 2) {
                    result += "(" + digits.substring(0, 2) + ") ";
                    digits = digits.substring(2);
                } else {
                    result += digits;
                    input.value = result;
                    return;
                }

                if (digits.length <= 4) {
                    result += digits;
                } else if (digits.length <= 8) {
                    result += digits.substring(0, 4) + "-" + digits.substring(4);
                } else {
                    result += digits.substring(0, 5) + "-" + digits.substring(5);
                }

                input.value = result;
            });

            input.addEventListener("keydown", function (e) {
                if (input.selectionStart < PREFIX.length) {
                    input.setSelectionRange(PREFIX.length, PREFIX.length);
                }
            });
        }

        // ======== VALIDAÇÃO DE SENHA EM TEMPO REAL ========

        const senha = document.getElementById("senha");
        const confirmar = document.getElementById("confirmarSenha");

        const msgSenha = document.getElementById("senhaMensagem");
        const msgConfirmar = document.getElementById("confirmarMensagem");

        const botao = document.getElementById("btnCadastrar");

        function validarSenhaForte(valor) {
            const min = valor.length >= 6;
            const letra = /[A-Za-z]/.test(valor);
            const numero = /[0-9]/.test(valor);

            return min && letra && numero;
        }

        function validarFormulario() {
            const s = senha.value;
            const c = confirmar.value;

            let senhaValida = validarSenhaForte(s);
            let senhasIguais = s === c && s.length > 0;

            if (!senhaValida) {
                msgSenha.textContent = "A senha deve ter pelo menos 6 caracteres, letras e números.";
            } else {
                msgSenha.textContent = "";
            }

            if (!senhasIguais) {
                msgConfirmar.textContent = "As senhas não conferem.";
            } else {
                msgConfirmar.textContent = "";
            }

            botao.disabled = !(senhaValida && senhasIguais);
        }

        senha.addEventListener("input", validarFormulario);
        confirmar.addEventListener("input", validarFormulario);

        validarFormulario();
    });
</script>

<style>
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #2f6f68;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c8f8b;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-size: 13px;
        color: #4a6f6a;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    .btn-primary-auth {
        width: 100%;
        height: 48px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn-primary-auth:hover {
            background: #3da59b;
        }

        .btn-primary-auth:disabled {
            background: #a0cfc9;
            cursor: not-allowed;
        }

    .divider {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

        .divider span {
            background: white;
            padding: 0 10px;
            color: #9aa;
            font-size: 13px;
        }

        .divider::before {
            content: "";
            height: 1px;
            background: #e0e0e0;
            width: 100%;
            position: absolute;
            top: 50%;
            left: 0;
            z-index: -1;
        }

    .social-login {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-social {
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .btn-social.google {
            border: 1px solid #db4437;
            color: #db4437;
        }

        .btn-social.facebook {
            border: 1px solid #3b5998;
            color: #3b5998;
        }

        .btn-social:hover {
            opacity: 0.85;
        }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
    }

        .auth-footer a {
            color: #4db6ac;
            font-weight: 600;
            text-decoration: none;
        }
</style>
