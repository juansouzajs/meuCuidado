@model meuCuidado.Dominio.ViewModels.CadastroViewModel
@{
    ViewBag.Title = "Cadastro de Profissional";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Cadastro de Profissional</h1>
        <p class="auth-subtitle">
            Envie seus documentos para concluir o cadastro 💚
        </p>

        @using (Html.BeginForm("CadastroProfissional", "Cadastro", FormMethod.Post, new { enctype = "multipart/form-data" }))
        {
            @Html.HiddenFor(model => model.TipoUsuario)
            @Html.HiddenFor(model => model.Usuario.Nome)
            @Html.HiddenFor(model => model.Usuario.Email)
            @Html.HiddenFor(model => model.Usuario.Endereco)
            @Html.HiddenFor(model => model.Usuario.Telefone)
            @Html.HiddenFor(model => model.Usuario.Senha)

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.CPF, "CPF")
                @Html.TextBoxFor(m => m.Usuario.CPF, new { @class = "form-control", placeholder = "Digite seu CPF", required = "required" })
                @Html.ValidationMessageFor(m => m.Usuario.CPF, "", new { @class = "text-danger" })
            </div>

            <div class="form-group">
                @Html.LabelFor(m => m.Usuario.Genero, "Gênero")
                @Html.DropDownListFor(
                    m => m.Usuario.Genero,
                    new SelectList(new[] { "Feminino", "Masculino" }),
                    "Selecione",
                    new { @class = "form-control", id = "Genero", required = "required" }
                )
                @Html.ValidationMessageFor(m => m.Usuario.Genero, "", new { @class = "text-danger" })
            </div>

            <div id="areaDocumentos" style="display:none;">

                <div class="form-group">
                    <label>Foto com Documento</label>
                    <input type="file" name="FotoDocumento" class="form-control documentoObrigatorio" />
                </div>

                <div class="form-group">
                    <label>Foto do Documento</label>
                    <input type="file" name="Documento" class="form-control documentoObrigatorio" />
                </div>

                <div class="form-group">
                    <label>Certificado de Bons Antecedentes</label>
                    <input type="file" name="CertificadoBonsAntecedentes" class="form-control documentoObrigatorio" />
                </div>

                <div class="form-group" id="dispensaExercito" style="display:none;">
                    <label>Certificado de Dispensa do Exército</label>
                    <input type="file" name="CertificadoDispensa" class="form-control" />
                </div>

            </div>

            <button type="submit" class="btn-primary-auth">
                Finalizar Cadastro
            </button>
        }
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        function atualizarCampos() {
            var genero = $('#Genero').val();

            if (genero === "") {
                $('#areaDocumentos').slideUp();

                $('.documentoObrigatorio').removeAttr('required');
                $('input[name="CertificadoDispensa"]').removeAttr('required');

                return;
            }

            $('#areaDocumentos').slideDown();

            // Torna todos os documentos obrigatórios
            $('.documentoObrigatorio').attr('required', 'required');

            if (genero === 'Masculino') {
                $('#dispensaExercito').slideDown();
                $('input[name="CertificadoDispensa"]').attr('required', 'required');
            } else {
                $('#dispensaExercito').slideUp();
                $('input[name="CertificadoDispensa"]').removeAttr('required');
            }
        }

        $('#Genero').change(function () {
            atualizarCampos();
        });

        atualizarCampos();
    });
</script>

<style>
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #2f6f68;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c8f8b;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-size: 13px;
        color: #4a6f6a;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    .btn-primary-auth {
        width: 100%;
        height: 48px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn-primary-auth:hover {
            background: #3da59b;
        }

    input[type="file"] {
        padding: 8px;
        background: #f0f7f6;
        cursor: pointer;
    }

        input[type="file"]::file-selector-button {
            background: #4db6ac;
            color: white;
            border: none;
            padding: 8px 14px;
            border-radius: 8px;
            margin-right: 10px;
            cursor: pointer;
            font-size: 13px;
        }

            input[type="file"]::file-selector-button:hover {
                background: #3da59b;
            }
</style>
