@model IList<meuCuidado.Dominio.ViewModels.ConfiguracoesViewModel>
@{
    ViewBag.Title = "Configurações";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-8 col-sm-10">

        <h4 class="mb-4 text-center">Configurações</h4>

        <div class="row">
            @foreach (var config in Model)
            {
                var isLogout = config.Titulo == "Sair da conta";

                <div class="col-md-6 mb-4">
                    <a href="@config.Link" class="config-card @(isLogout ? "logout" : "")">
                        <div class="card h-100">
                            <div class="card-body">
                                <h5 class="card-title">@config.Titulo</h5>
                                <p class="card-text">@config.Descricao</p>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>

    </div>
</div>

<style>

    .config-card {
        text-decoration: none;
        color: inherit;
    }

        .config-card .card {
            border-radius: 12px;
            border: 1px solid #e5e7eb;
            transition: all 0.2s ease;
            cursor: pointer;
            background-color: #ffffff;
        }

            .config-card .card:hover {
                transform: translateY(-4px);
                box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            }

        .config-card .card-title {
            font-size: 18px;
            font-weight: 600;
            margin-bottom: 6px;
            color: #2c3e50;
        }

        .config-card .card-text {
            font-size: 14px;
            color: #6b7280;
        }

        /* CARD DE LOGOUT */

        .config-card.logout .card {
            border-color: #fecaca;
            background: #fff7f7;
        }

        .config-card.logout .card-title {
            color: #dc2626;
        }

        .config-card.logout:hover .card {
            box-shadow: 0 10px 25px rgba(220,38,38,0.15);
        }
</style>