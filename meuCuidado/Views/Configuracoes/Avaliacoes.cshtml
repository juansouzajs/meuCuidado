@model IList<meuCuidado.Dominio.Models.Avaliacao>

@{
    Layout = null;
}

<h4 class="mb-4">Minhas Avaliações</h4>

@if (!Model.Any())
{
    <p class="text-muted">Você ainda não recebeu avaliações.</p>
}
else
{
    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card avaliacao-card">
                    <div class="card-body">

                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong>Nota:</strong>
                            <span class="badge bg-success">@item.Nota ★</span>
                        </div>

                        <p class="comentario">
                            @(string.IsNullOrEmpty(item.Comentario)
                                ? "Sem comentário."
                                : item.Comentario)
                        </p>

                    </div>
                </div>
            </div>
        }
    </div>
}

<script>
    function carregarAvaliacoes() {
        $.ajax({
            url: '/Avaliacao/MinhasAvaliacoes',
            type: 'GET',
            success: function (data) {
                $('#contentContainer').html(data);

                $('.btn-dashboard').removeClass('active');
                $('#configBtn').addClass('active');
            },
            error: function () {
                alert("Erro ao carregar avaliações.");
            }
        });
    }
</script>

<style>
    .avaliacao-card {
        border-radius: 12px;
        border: 1px solid #e5e7eb;
        transition: all 0.2s ease;
    }

        .avaliacao-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        }

    .comentario {
        font-size: 14px;
        color: #6b7280;
        margin-top: 10px;
    }
</style>