@model IList<meuCuidado.Dominio.Models.Avaliacao>

@{
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="perfil-wrapper">

    <div class="topo-voltar">
        <button onclick="window.history.back()" class="btn-voltar">
            <i class="fas fa-arrow-left"></i> Voltar
        </button>
    </div>

    <div class="perfil-header">
        <h2 class="perfil-nome">Minhas Avaliações</h2>
        <p class="perfil-subtitle">Veja o que estão falando sobre você</p>
    </div>

    @if (Model == null || !Model.Any())
    {
        <p class="text-muted text-center">Você ainda não recebeu avaliações.</p>
    }
    else
    {
        <div class="perfil-grid">
            <div class="card-soft">
                <h3>Feedbacks</h3>

                @foreach (var item in Model)
                {
                    var avaliador =
                        item.RelacionamentoIdosoProfissional?.Tutor?.Nome
                        ?? item.RelacionamentoIdosoProfissional?.Idoso?.Nome
                        ?? "Usuário";

                    <div class="avaliacao-item">
                        <div class="avaliacao-topo">
                            <strong>@avaliador</strong>
                            <span class="nota">@item.Nota ★</span>
                        </div>

                        <p class="comentario">
                            @(string.IsNullOrEmpty(item.Comentario)
                                ? "Sem comentário."
                                : item.Comentario)
                        </p>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .perfil-wrapper {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    .perfil-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .perfil-nome {
        color: #2f6f68;
        font-weight: 600;
    }

    .perfil-subtitle {
        color: #6c8f8b;
        font-size: 14px;
    }

    .perfil-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }

    .card-soft {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    .avaliacao-item {
        border-bottom: 1px solid #eee;
        padding: 12px 0;
    }

    .avaliacao-topo {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .nota {
        background: #4db6ac;
        color: white;
        padding: 4px 10px;
        border-radius: 999px;
        font-size: 12px;
    }

    .comentario {
        font-size: 14px;
        color: #6b7280;
        margin-top: 6px;
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: white;
        color: #4db6ac;
        border: 1px solid #4db6ac;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        margin-bottom: 10px;
    }

        .btn-voltar:hover {
            background: #4db6ac;
            color: white;
        }
</style>