@model meuCuidado.Dominio.ViewModels.AutenticacaoViewModel
@{
    ViewBag.Title = "Login";
}

<div class="row justify-content-center">
    <div class="col-md-4 col-sm-8">

        <div class="card shadow-sm mt-5">
            <div class="card-body">

                <h4 class="text-center mb-4">Entrar</h4>

                @using (Html.BeginForm("Login", "Login", FormMethod.Post))
                {
                    <div class="form-group">
                        @Html.LabelFor(m => m.Email)
                        @Html.TextBoxFor(m => m.Email, new
                        {
                            @class = "form-control",
                            placeholder = "seu@email.com"
                        })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group">
                        @Html.Label("Senha")
                        @Html.Password("senha", null, new
                        {
                            @class = "form-control",
                            placeholder = "••••••••"
                        })
                    </div>

                    <button type="submit" class="btn btn-primary btn-block">
                        Entrar
                    </button>
                }

                <!-- Login social -->
                <div class="social-login-buttons mt-4">
                    <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })"
                       class="btn btn-outline-danger btn-block">
                        <img src="~/Imagens/gmail-logo.png" class="social-logo" />
                        Entrar com Gmail
                    </a>

                    <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })"
                       class="btn btn-outline-primary btn-block">
                        <img src="~/Imagens/facebook-logo.png" class="social-logo" />
                        Entrar com Facebook
                    </a>
                </div>

                @if (ViewBag.ErrorMessage != null)
                {
                    <div class="alert alert-danger mt-3 text-center">
                        @ViewBag.ErrorMessage
                    </div>
                }

                <p class="text-center mt-3 mb-0">
                    Não tem uma conta?
                    <a href="@Url.Action("Cadastro", "Cadastro")">Cadastre-se</a>
                </p>

            </div>
        </div>

    </div>
</div>

@if (ViewBag.PopupMessage != null || ViewBag.SuccessMessage != null)
{
    <script>
        $(function () {
            const message = '@(ViewBag.PopupMessage ?? ViewBag.SuccessMessage)';
            showToaster(message, 'success');
        });
    </script>
}

<style>
    .social-login-buttons {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .social-logo {
        width: 18px;
        height: 18px;
        margin-right: 8px;
    }

    .btn img {
        vertical-align: middle;
    }
</style>
