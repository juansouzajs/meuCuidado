@model meuCuidado.Dominio.ViewModels.AutenticacaoViewModel
@{
    ViewBag.Title = "Login";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Entrar</h1>
        <p class="auth-subtitle">
            Que bom ter você de volta 💚
        </p>

        <div class="form-group">
            <label>Email</label>
            <input type="email" id="email" class="form-control" placeholder="seu@email.com" />
            <small id="emailErro" class="email-erro"></small>
        </div>

        <div class="form-group">
            <label>Senha</label>
            <input type="password" id="senha" class="form-control" placeholder="Digite sua senha" />
        </div>

        <button type="button" id="btnLogin" class="btn-primary-auth">
            Entrar
        </button>

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="social-login">
            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })" class="btn-social google">
                Entrar com Google
            </a>

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })" class="btn-social facebook">
                Entrar com Facebook
            </a>
        </div>

        <p class="auth-footer">
            Não tem uma conta?
            <a href="@Url.Action("Cadastro", "Cadastro")">Cadastre-se</a>
        </p>
    </div>
</div>

@if (ViewBag.PopupMessage != null || ViewBag.SuccessMessage != null)
{
    <script>
        $(function () {
            const message = '@(ViewBag.PopupMessage ?? ViewBag.SuccessMessage)';
            showToaster(message, 'success');
        });
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

function validarEmail(email){

    const regex = /^[^\s@@]+@@[^\s@@]+\.(com|com\.br|gov)$/;

    return regex.test(email);
}

$("#email").on("input", function(){

    let email = $(this).val();

    if(email.length === 0){
        $("#emailErro").text("");
        $(this).removeClass("input-invalido input-valido");
        return;
    }

    if(validarEmail(email)){
        $("#emailErro").text("Email válido").css("color","#2e7d32");
        $(this).removeClass("input-invalido").addClass("input-valido");
    }
    else{
        $("#emailErro").text("Digite um email válido (.com, .com.br ou .gov)").css("color","#dc3545");
        $(this).removeClass("input-valido").addClass("input-invalido");
    }

});


$("#btnLogin").click(function(){

    let email = $("#email").val();
    let senha = $("#senha").val();

    if(!validarEmail(email)){
        showToaster("Digite um email válido",'error');
        return;
    }

    $.ajax({
        url: '@Url.Action("RealizarLogin","Login")',
        type: 'POST',
        data: {
            email: email,
            senha: senha
        },

        success: function(response){

            if(response.success === false){
                showToaster(response.message,'error');
            }
            else{
                document.open();
                document.write(response);
                document.close();
            }

        },

        error:function(){
            showToaster("Erro ao tentar realizar login",'error');
        }
    });

});

</script>

<style>

    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .auth-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 20px;
    }

    .auth-card {
        background: #ffffff;
        width: 100%;
        max-width: 420px;
        padding: 30px;
        border-radius: 16px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .auth-title {
        font-size: 26px;
        font-weight: 600;
        text-align: center;
        color: #2f6f68;
    }

    .auth-subtitle {
        text-align: center;
        color: #6c8f8b;
        margin-bottom: 25px;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        font-size: 13px;
        color: #4a6f6a;
        margin-bottom: 5px;
    }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    .input-invalido {
        border-color: #dc3545 !important;
    }

    .input-valido {
        border-color: #2e7d32 !important;
    }

    .email-erro {
        font-size: 12px;
        display: block;
        margin-top: 4px;
    }

    .btn-primary-auth {
        width: 100%;
        height: 48px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 16px;
        font-weight: 600;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn-primary-auth:hover {
            background: #3da59b;
        }

    .divider {
        text-align: center;
        margin: 20px 0;
        position: relative;
    }

        .divider span {
            background: white;
            padding: 0 10px;
            color: #9aa;
            font-size: 13px;
        }

        .divider::before {
            content: "";
            height: 1px;
            background: #e0e0e0;
            width: 100%;
            position: absolute;
            top: 50%;
            left: 0;
            z-index: -1;
        }

    .social-login {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .btn-social {
        height: 45px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
    }

        .btn-social.google {
            border: 1px solid #db4437;
            color: #db4437;
        }

        .btn-social.facebook {
            border: 1px solid #3b5998;
            color: #3b5998;
        }

        .btn-social:hover {
            opacity: 0.85;
        }

    .auth-footer {
        text-align: center;
        margin-top: 20px;
        font-size: 14px;
    }

        .auth-footer a {
            color: #4db6ac;
            font-weight: 600;
            text-decoration: none;
        }
</style>
