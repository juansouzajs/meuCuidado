@model meuCuidado.Dominio.ViewModels.AutenticacaoViewModel
@{
    ViewBag.Title = "Login";
}

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">Entrar</h1>
        <p class="auth-subtitle">
            Que bom ter você de volta 💚
        </p>

        <div class="form-group">
            <label>Email</label>
            <input type="email" id="email" class="form-control" placeholder="seu@email.com" />
            <small id="emailErro" class="email-erro"></small>
        </div>

        <div class="form-group">
            <label>Senha</label>
            <input type="password" id="senha" class="form-control" placeholder="Digite sua senha" />
        </div>

        <div class="privacy-consent">

            <input type="checkbox" id="aceitoPolitica" />

            <label for="aceitoPolitica">
                Ao acessar você concorda com a nossa
                <a href="javascript:void(0)"
                   id="abrirPolitica">
                    Política de Privacidade
                </a>.
            </label>

        </div>

        <button type="button"
                id="btnLogin"
                class="btn-primary-auth"
                disabled>
            Entrar
        </button>

        <div class="divider">
            <span>ou</span>
        </div>

        <div class="social-login">
            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Google" })" class="btn-social google">
                Entrar com Google
            </a>

            <a href="@Url.Action("ExternalLogin", "Login", new { provider = "Facebook" })" class="btn-social facebook">
                Entrar com Facebook
            </a>
        </div>

        <p class="auth-footer">
            Não tem uma conta?
            <a href="@Url.Action("Cadastro", "Cadastro")">Cadastre-se</a>
        </p>
    </div>
</div>

<div id="modalPolitica" class="modal-politica">

    <div class="modal-politica-content">

        <div class="modal-header-politica">

            <h2>Política de Privacidade</h2>

            <button type="button"
                    id="fecharPolitica">
                ×
            </button>

        </div>

        <div class="modal-body-politica">

            <h3>Compromisso com sua privacidade</h3>

            <p>
                O meuCuidado respeita sua privacidade e trata seus dados
                pessoais com responsabilidade, transparência e segurança.
            </p>

            <p>
                Coletamos apenas as informações estritamente necessárias
                para possibilitar a utilização da plataforma, a conexão
                entre famílias e profissionais, autenticação de usuários,
                suporte técnico e melhoria dos serviços oferecidos.
            </p>

            <h3>Conformidade com a LGPD</h3>

            <p>
                O meuCuidado atua em conformidade com a
                Lei nº 13.709/2018 (Lei Geral de Proteção de Dados - LGPD),
                garantindo que seus dados pessoais sejam tratados apenas
                para finalidades legítimas, específicas e informadas.
            </p>

            <p>
                Seus dados não são comercializados, compartilhados ou
                divulgados para terceiros sem fundamento legal,
                consentimento ou necessidade operacional relacionada ao
                funcionamento da plataforma.
            </p>

            <h3>Dados coletados</h3>

            <ul>
                <li>Nome e informações de identificação.</li>
                <li>Email e telefone para contato.</li>
                <li>Informações profissionais quando aplicável.</li>
                <li>Dados necessários para autenticação e segurança.</li>
            </ul>

            <h3>Seus direitos</h3>

            <p>
                Nos termos da LGPD, você poderá solicitar acesso,
                correção, atualização, portabilidade ou exclusão
                de seus dados pessoais, respeitadas as obrigações
                legais aplicáveis.
            </p>

            <h3>Segurança</h3>

            <p>
                Adotamos medidas técnicas e administrativas adequadas
                para proteger suas informações contra acessos não
                autorizados, perda, alteração ou divulgação indevida.
            </p>

            <p>
                Ao utilizar a plataforma você declara ter lido e
                concordado com esta Política de Privacidade.
            </p>

        </div>

    </div>

</div>

@if (ViewBag.PopupMessage != null || ViewBag.SuccessMessage != null)
{
    <script>
        $(function () {
            const message = '@(ViewBag.PopupMessage ?? ViewBag.SuccessMessage)';
            showToaster(message, 'success');
        });
    </script>
}

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

function validarEmail(email){

    const regex = /^[^\s@@]+@@[^\s@@]+\.(com|com\.br|gov)$/;

    return regex.test(email);
}

$("#email").on("input", function(){

    let email = $(this).val();

    if(email.length === 0){
        $("#emailErro").text("");
        $(this).removeClass("input-invalido input-valido");
        return;
    }

    if(validarEmail(email)){
        $("#emailErro").text("Email válido").css("color","#2e7d32");
        $(this).removeClass("input-invalido").addClass("input-valido");
    }
    else{
        $("#emailErro").text("Digite um email válido (.com, .com.br ou .gov)").css("color","#dc3545");
        $(this).removeClass("input-valido").addClass("input-invalido");
    }

});


$("#btnLogin").click(function(){

    let email = $("#email").val();
    let senha = $("#senha").val();

    if(!validarEmail(email)){
        showToaster("Digite um email válido",'error');
        return;
    }

    $.ajax({
        url: '@Url.Action("RealizarLogin","Login")',
        type: 'POST',
        data: {
            email: email,
            senha: senha
        },

        success: function(response){

            if(response.success === false){
                showToaster(response.message,'error');
            }
            else{
                window.location.href = response.redirectUrl;
            }

        },

        error:function(){
            showToaster("Erro ao tentar realizar login",'error');
        }
    });

});

    $("#aceitoPolitica").change(function () {

        $("#btnLogin").prop(
            "disabled",
            !$(this).is(":checked")
        );

    });

    $("#abrirPolitica").click(function () {

        $("#modalPolitica").fadeIn(200);

    });

    $("#fecharPolitica").click(function () {

        $("#modalPolitica").fadeOut(200);

    });

    $("#modalPolitica").click(function (e) {

        if (e.target === this) {
            $(this).fadeOut(200);
        }

    });

</script>

<style>
