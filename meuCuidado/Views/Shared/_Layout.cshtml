<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - meuCuidado</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

    <!-- Toastr -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" rel="stylesheet" />

    <!-- CSS Projeto -->
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/estilos.css" rel="stylesheet" />

    @RenderSection("styles", required: false)

    <style>

        :root {
            --primary: #4db6ac;
            --primary-dark: #3da59b;
            --bg: #f4fbfa;
            --text: #2f6f68;
            --muted: #7c8d8b;
            --card: #ffffff;
        }

        html,
        body {
            min-height: 100vh;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', sans-serif;
            background: linear-gradient(135deg,#eef8f7,#f8fbff);
        }

        body {
            display: flex;
            flex-direction: column;
        }

        /* NAVBAR */

        .navbar-custom {
            background: rgba(255,255,255,.95);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid #e7eeee;
            min-height: 72px;
            box-shadow: 0 3px 20px rgba(0,0,0,.04);
        }

        .navbar-brand {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--primary) !important;
        }

            .navbar-brand i {
                margin-right: 8px;
            }

        .nav-link {
            color: #666 !important;
            font-weight: 500;
            transition: .2s;
        }

            .nav-link:hover {
                color: var(--primary) !important;
            }

        /* MAIN */

        .main-wrapper {
            flex: 1;
            padding: 35px 0;
        }

        .body-content {
            background: rgba(255,255,255,.75);
            backdrop-filter: blur(10px);
            border-radius: 24px;
            padding: 30px;
            box-shadow: 0 15px 40px rgba(0,0,0,.06);
            min-height: 70vh;
        }

        /* FOOTER */

        footer {
            margin-top: auto;
            background: white;
            border-top: 1px solid #edf2f2;
            padding: 18px;
        }

        .footer-text {
            text-align: center;
            color: #7a8b89;
            margin: 0;
            font-size: .95rem;
        }

        /* TOAST */

        #toaster {
            position: fixed;
            top: 25px;
            right: 25px;
            z-index: 99999;
            display: none;
            min-width: 280px;
            padding: 16px 20px;
            border-radius: 14px;
            color: white;
            font-weight: 600;
            box-shadow: 0 12px 35px rgba(0,0,0,.18);
        }

            #toaster.success {
                background: #4db6ac;
            }

            #toaster.error {
                background: #ef5350;
            }

        /* RESPONSIVO */

        @@media(max-width:768px) {

            .body-content {
                padding: 20px;
                border-radius: 18px;
            }

            .navbar-brand {
                font-size: 1.2rem;
            }

            #toaster {
                right: 10px;
                left: 10px;
                min-width: auto;
            }
        }
    </style>

</head>
<body>

    <!-- NAVBAR -->

    <nav class="navbar navbar-expand-lg navbar-light navbar-custom">

        <div class="container">

            @Html.ActionLink(
                "meuCuidado",
                "meuCuidado",
                "Home",
                null,
                new { @class = "navbar-brand" }
            )

            <button class="navbar-toggler"
                    type="button"
                    data-toggle="collapse"
                    data-target="#navbarMenu">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="navbarMenu">

                <ul class="navbar-nav ml-auto">

                    <li class="nav-item">

                        @Html.ActionLink(
                            "Home",
                            "meuCuidado",
                            "Home",
                            null,
                            new { @class = "nav-link" }
                        )

                    </li>

                    <li class="nav-item">

                        @Html.ActionLink(
                            "Ajuda",
                            "Ajuda",
                            "Ajuda",
                            null,
                            new { @class = "nav-link" }
                        )

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- TOASTER -->

    <div id="toaster"></div>

    <!-- CONTEÚDO -->

    <main class="main-wrapper">

        <div class="container">

            <div class="body-content">

                @RenderBody()

            </div>

        </div>

    </main>

    <!-- FOOTER -->

    <footer>

        <p class="footer-text">
            © @DateTime.Now.Year - meuCuidado • Conectando idosos, cuidadores e familiares.
        </p>

    </footer>

    <!-- SCRIPTS -->

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <script>

        function showToaster(message, type) {

            const toaster = $("#toaster");

            toaster.removeClass("success error");

            toaster.addClass(
                type === "error"
                    ? "error"
                    : "success"
            );

            toaster
                .stop(true, true)
                .text(message)
                .fadeIn();

            setTimeout(function () {
                toaster.fadeOut();
            }, 3500);
        }

    </script>

    @RenderSection("scripts", required: false)

</body>
</html>