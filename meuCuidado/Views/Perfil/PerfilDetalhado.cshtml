@model meuCuidado.Dominio.ViewModels.PerfilDetalhadoViewModel
@{
    ViewBag.Title = "Perfil Detalhado";
    Layout = null;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="perfil-wrapper">

    <!-- HEADER -->
    <div class="perfil-header">
        <div class="perfil-avatar-wrapper">
            <img src="https://i.pinimg.com/564x/ac/0f/41/ac0f419e977af681516e00829c5393ee.jpg"
                 class="perfil-avatar" />
        </div>

        <h2 class="perfil-nome">
            @(Model.CuidadorDeIdoso?.Nome
            ?? Model.Fisioterapeuta?.Nome
            ?? Model.Idoso?.Nome
            ?? Model.Tutor?.Nome)
        </h2>

        <p class="perfil-subtitle">Conecte-se e acompanhe informações</p>

        <div class="acoes-perfil">
            <a href="@Url.Action("SolicitarConexao", "Relacionamento", new { identificador = Model.CuidadorDeIdoso?.IdentificadorUnico
                ?? Model.Fisioterapeuta?.IdentificadorUnico })"
               class="btn-primary-soft">
                <i class="fab fa-whatsapp"></i>
                Solicitar conexão
            </a>
        </div>
    </div>

    <!-- CONTEÚDO -->
    <div class="perfil-grid">

        @if (Model.TipoUsuario == "Tutor" || Model.TipoUsuario == "Idoso")
        {
            <!-- CURRÍCULO -->
            <div class="card-soft">
                <h3>Currículo</h3>

                <div class="secao">
                    <h4>Cursos</h4>
                    <ul>
                        @foreach (var curso in Model.Curriculo.Cursos)
                        {
                            <li>@curso</li>
                        }
                    </ul>
                </div>

                <div class="secao">
                    <h4>Experiências</h4>
                    <ul>
                        @foreach (var experiencia in Model.Curriculo.Experiencias)
                        {
                            <li>@experiencia</li>
                        }
                    </ul>
                </div>
            </div>

            <!-- AVALIAÇÃO -->
            <div class="card-soft">
                <h3>Avaliação</h3>

                @{
                    var media = Model.Curriculo.AvaliacaoMedia;
                    var estrelasCheias = (int)Math.Floor(media);
                    var temMeia = (media - estrelasCheias) >= 0.5;
                    var estrelasVazias = 5 - estrelasCheias - (temMeia ? 1 : 0);
                }

                <div class="avaliacao-estrelas">
                    @for (int i = 0; i < estrelasCheias; i++)
                    {
                        <i class="fas fa-star estrela cheia"></i>
                    }

                    @if (temMeia)
                    {
                        <i class="fas fa-star-half-alt estrela meia"></i>
                    }

                    @for (int i = 0; i < estrelasVazias; i++)
                    {
                        <i class="far fa-star estrela vazia"></i>
                    }

                    <span class="media-numero">@media.ToString("0.0")</span>
                </div>

                <p class="avaliacao-total">Total: @Model.Curriculo.NumeroAvaliacoes</p>

                <div>
                    @if (media >= 4)
                    {
                        <span class="badge excelente">Excelente</span>
                    }
                    else if (media >= 3)
                    {
                        <span class="badge bom">Bom</span>
                    }
                    else if (media > 0)
                    {
                        <span class="badge regular">Ruim</span>
                    }
                </div>
            </div>
        }

        <!-- REDES -->
        <div class="card-soft redes">
            <h3>Redes Sociais</h3>

            <div class="redes-lista">
                <a href="#" class="rede facebook"><i class="fab fa-facebook-f"></i></a>
                <a href="#" class="rede instagram"><i class="fab fa-instagram"></i></a>
                <a href="#" class="rede youtube"><i class="fab fa-youtube"></i></a>
            </div>
        </div>

    </div>
</div>

@if (TempData["Sucesso"] != null)
{
    <div class="toast" id="toast">
        @TempData["Sucesso"]
    </div>
}

<style>

    /* BACKGROUND */
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    /* WRAPPER */
    .perfil-wrapper {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    /* HEADER */
    .perfil-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .perfil-avatar-wrapper {
        margin-bottom: 15px;
    }

    .perfil-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .perfil-nome {
        color: #2f6f68;
        font-weight: 600;
    }

    .perfil-subtitle {
        color: #6c8f8b;
        font-size: 14px;
    }

    /* BOTÃO */
    .btn-primary-soft {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
        padding: 12px 20px;
        background: #4db6ac;
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-primary-soft:hover {
            background: #3da59b;
            transform: translateY(-2px);
        }

    /* GRID */
    .perfil-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    /* CARD */
    .card-soft {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    /* LISTA */
    ul {
        list-style: none;
        padding: 0;
    }

        ul li {
            background: #f5f9f8;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
        }

    /* AVALIAÇÃO */
    .avaliacao-estrelas {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .estrela.cheia, .estrela.meia {
        color: #ffc107;
    }

    .estrela.vazia {
        color: #ddd;
    }

    .media-numero {
        margin-left: 6px;
        font-weight: 600;
    }

    /* BADGE */
    .badge {
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 12px;
    }

    .excelente {
        background: #d1f7e3;
    }

    .bom {
        background: #e7f1ff;
    }

    .regular {
        background: #fff3cd;
    }

    /* REDES */
    .redes-lista {
        display: flex;
        gap: 10px;
    }

    .rede {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .facebook {
        background: #1877f2;
    }

    .instagram {
        background: linear-gradient(45deg,#f58529,#dd2a7b,#8134af);
    }

    .youtube {
        background: #ff0000;
    }

    /* TOAST */
    .toast {
        position: fixed;
        top: 20px;
        right: 20px;
        background: #4db6ac;
        color: white;
        padding: 14px 20px;
        border-radius: 10px;
    }

    /* RESPONSIVO */
    @@media (max-width: 768px) {
        .perfil-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<script>
    setTimeout(function () {
        var toast = document.getElementById("toast");
        if (toast) {
            toast.style.opacity = "0";
            setTimeout(() => toast.remove(), 500);
        }
    }, 3000);
</script>