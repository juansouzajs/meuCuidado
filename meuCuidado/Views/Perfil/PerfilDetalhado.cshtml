@model meuCuidado.Dominio.ViewModels.PerfilDetalhadoViewModel
@using System.Linq
@{
    ViewBag.Title = "Perfil Detalhado";
    Layout = null;

    var podeSolicitar = Model.TipoUsuario == "Tutor" || Model.TipoUsuario == "Idoso";
    var temConexao = Model.TemConexaoAtiva;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="perfil-wrapper">

    <div class="topo-voltar">
        <button onclick="voltarPagina()" class="btn-voltar">
            <i class="fas fa-arrow-left"></i> Voltar
        </button>
    </div>

    <!-- HEADER -->
    <div class="perfil-header">
        <div class="perfil-avatar-wrapper">
            @{
                var foto = string.IsNullOrEmpty(Model.FotoUrl)
                    ? "/ImagensPerfil/default.jpg"
                    : Model.FotoUrl;
            }

            <img src="@foto" class="perfil-avatar" />
        </div>

        <h2 class="perfil-nome">
            @(Model.CuidadorDeIdoso?.Nome
            ?? Model.Fisioterapeuta?.Nome
            ?? Model.Idoso?.Nome
            ?? Model.Tutor?.Nome)
        </h2>

        <p class="perfil-subtitle">Conecte-se nas redes sociais e acompanhe informações</p>

        <div class="acoes-perfil">

            @if (podeSolicitar && !temConexao && !Model.ConexaoPendente)
            {
                <a href="@Url.Action("SolicitarConexao", "Relacionamento", new {
            identificador = Model.CuidadorDeIdoso?.IdentificadorUnico
            ?? Model.Fisioterapeuta?.IdentificadorUnico
            })"
                   class="btn-primary-soft">
                    Solicitar conexão
                </a>
            }
            else if (podeSolicitar && Model.ConexaoPendente)
            {
                <button class="btn-primary-soft" disabled>
                    Conexão solicitada
                </button>
            }
            else if (podeSolicitar && temConexao && !Model.JaAvaliou)
            {
                <button class="btn-primary-soft" onclick="abrirModalAvaliacao()">
                    Avaliar
                </button>
            }
            else if (podeSolicitar && Model.JaAvaliou)
            {
                <button class="btn-primary-soft" disabled>
                    Já avaliado
                </button>
            }

            @if (temConexao && Model.Idoso != null)
            {
                <button class="btn-emergencia" onclick="abrirModalEmergencia()">
                    <i class="fas fa-triangle-exclamation"></i>
                    Emergência
                </button>
            }

            @if (temConexao && (Model.TipoUsuario == "Cuidador" || Model.TipoUsuario == "Fisioterapeuta")
    && (Model.Idoso != null || Model.Tutor != null))
            {
                <button class="btn-primary-soft"
                        onclick="adicionarAoQuadro()">
                    <i class="fas fa-thumbtack"></i>
                    Adicionar ao quadro de lembretes
                </button>
            }

        </div>
        @if (temConexao)
        {
            var telefone =
                Model.CuidadorDeIdoso?.Telefone
                ?? Model.Fisioterapeuta?.Telefone
                ?? Model.Idoso?.Telefone
                ?? Model.Tutor?.Telefone;

            if (!string.IsNullOrEmpty(telefone))
            {
                var telefoneLimpo = new string(telefone.Where(char.IsDigit).ToArray());
                var linkWhatsapp = $"https://wa.me/55{telefoneLimpo}";

                <div class="card-soft contato-box">
                    <h3>Contato</h3>

                    <p>
                        <strong>Telefone:</strong> @telefone
                    </p>

                    <a href="@linkWhatsapp" target="_blank" class="btn-whatsapp">
                        <i class="fab fa-whatsapp"></i> Conversar no WhatsApp
                    </a>
                </div>
            }
        }
    </div>

    <!-- CONTEÚDO -->
    <div class="perfil-grid">
        @if (Model.Tutor != null || Model.Idoso != null)
        {
            var temNecessidades =
                Model.Tutor?.NecessidadesEspeciais
                ?? Model.Idoso?.NecessidadesEspeciais
                ?? false;

            var descricao =
                Model.Tutor?.DescricaoNecessidadesEspeciais
                ?? Model.Idoso?.DescricaoNecessidadesEspeciais
                ?? "";

            <div class="card-soft">
                <h3>Necessidades Especiais</h3>

                <p>
                    <strong>Possui:</strong> @(temNecessidades ? "Sim" : "Não")
                </p>

                @if (temNecessidades && !string.IsNullOrEmpty(descricao))
                {
                    <p>
                        <strong>Descrição:</strong><br />
                        @descricao
                    </p>
                }
            </div>
        }

        @if (Model.TipoUsuario == "Tutor" || Model.TipoUsuario == "Idoso")
        {
            <!-- CURRÍCULO -->
            <div class="card-soft">

                <h3>Currículo</h3>

                <div class="secao">

                    <h4>
                        Anos de experiência:
                        @Model.Curriculo.AnosExperiencia
                    </h4>

                    @if (!string.IsNullOrEmpty(Model.Curriculo.EscolaridadeNivel))
                    {
                        <div class="escolaridade-box">

                            <h4>Escolaridade</h4>

                            <p>
                                <strong>Nível:</strong>
                                @Model.Curriculo.EscolaridadeNivel
                            </p>

                            @if (!string.IsNullOrEmpty(Model.Curriculo.EscolaridadeNome))
                            {
                                <p>
                                    <strong>Formação:</strong>
                                    @Model.Curriculo.EscolaridadeNome
                                </p>
                            }

                        </div>
                    }

                    <h4>Cursos</h4>

                    @if (Model.Curriculo.Cursos.Any())
                    {
                        <ul>
                            @foreach (var curso in Model.Curriculo.Cursos)
                            {
                                <li>@curso</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Nenhum curso cadastrado</p>
                    }

                </div>

                <div class="secao">

                    <h4>Experiências</h4>

                    @if (Model.Curriculo.Experiencias.Any())
                    {
                        <ul>
                            @foreach (var experiencia in Model.Curriculo.Experiencias)
                            {
                                <li>@experiencia</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Nenhuma experiência cadastrada</p>
                    }

                </div>

            </div>

            <!-- AVALIAÇÃO -->
            <div class="card-soft">
                <h3>Avaliação</h3>

                @{
                    var avaliacoes = Model.Avaliacaos ?? new List<meuCuidado.Dominio.Models.Avaliacao>();
                    var total = avaliacoes.Count;
                    var media = total > 0 ? avaliacoes.Average(a => a.Nota) : 0;

                    var estrelasCheias = (int)Math.Floor(media);
                    var temMeia = (media - estrelasCheias) >= 0.5;
                    var estrelasVazias = 5 - estrelasCheias - (temMeia ? 1 : 0);
                }

                <div class="avaliacao-estrelas">
                    @for (int i = 0; i < estrelasCheias; i++)
                    {
                        <i class="fas fa-star estrela cheia"></i>
                    }

                    @if (temMeia)
                    {
                        <i class="fas fa-star-half-alt estrela meia"></i>
                    }

                    @for (int i = 0; i < estrelasVazias; i++)
                    {
                        <i class="far fa-star estrela vazia"></i>
                    }

                    <span class="media-numero">@media.ToString("0.0")</span>
                </div>

                <p class="avaliacao-total">Total: @total</p>

                <div>
                    @if (media >= 4)
                    {
                        <span class="badge excelente">Excelente</span>
                    }
                    else if (media >= 3)
                    {
                        <span class="badge bom">Bom</span>
                    }
                    else if (media > 0)
                    {
                        <span class="badge regular">Ruim</span>
                    }
                </div>

                <hr />

                @foreach (var avaliacao in avaliacoes.Take(5))
                {
                    <div style="margin-top:10px;">
                        <strong>@avaliacao.Nota ★</strong>
                        <p>@avaliacao.Comentario</p>
                    </div>
                }
            </div>
        }

        <!-- REDES -->
        @{
            var redes = Model.Curriculo?.RedesSociais ?? new List<string>();

            var facebook = redes.FirstOrDefault(x => x.ToLower().Contains("facebook"));
            var instagram = redes.FirstOrDefault(x => x.ToLower().Contains("instagram"));
            var linkedin = redes.FirstOrDefault(x => x.ToLower().Contains("linkedin"));
            var youtube = redes.FirstOrDefault(x => x.ToLower().Contains("youtube"));
        }

        <div class="card-soft redes">
            <h3>Redes Sociais</h3>

            <div class="redes-lista">

                @if (!string.IsNullOrEmpty(facebook))
                {
                    <a href="@facebook" target="_blank" class="rede facebook">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                }

                @if (!string.IsNullOrEmpty(instagram))
                {
                    <a href="@instagram" target="_blank" class="rede instagram">
                        <i class="fab fa-instagram"></i>
                    </a>
                }

                @if (!string.IsNullOrEmpty(linkedin))
                {
                    <a href="@linkedin" target="_blank" class="rede linkedin">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                }

                @if (!string.IsNullOrEmpty(youtube))
                {
                    <a href="@youtube" target="_blank" class="rede youtube">
                        <i class="fab fa-youtube"></i>
                    </a>
                }

                @if (!string.IsNullOrEmpty(facebook) == false &&
                     !string.IsNullOrEmpty(instagram) == false &&
                     !string.IsNullOrEmpty(linkedin) == false &&
                     !string.IsNullOrEmpty(youtube) == false)
                {
                    <p style="color:#888;">Nenhuma rede cadastrada</p>
                }

            </div>
        </div>

    </div>
</div>

<!-- MODAL -->
<div id="modalAvaliacao" class="modal">
    <div class="modal-box">

        <h3>Avaliar</h3>

        <div class="estrelas" id="estrelas">
            @for (int i = 1; i <= 5; i++)
            {
                <i class="fa fa-star" data-value="@i"></i>
            }
        </div>

        <textarea id="comentario"
                  maxlength="200"
                  placeholder="Escreva um comentário (máx. 200 caracteres)..."></textarea>

        <div class="contador">
            <span id="count">0</span>/200
        </div>

        <div class="acoes-modal">
            <button class="btn-enviar" onclick="enviarAvaliacao()">Enviar</button>
            <button class="btn-cancelar" onclick="fecharModal()">Cancelar</button>
        </div>

    </div>
</div>

@if (Model.Idoso != null && temConexao)
{
    <div id="modalEmergencia" class="modal">

        <div class="modal-box emergencia-box">

            <h2>
                <i class="fas fa-triangle-exclamation"></i>
                Contatos de Emergência
            </h2>

            <hr />

            <h3>Tutor Responsável</h3>

            <p>
                <strong>Nome:</strong>
                @(Model.Idoso.Tutor != null ? Model.Idoso.Tutor.Nome : "")
            </p>

            <p>
                <strong>Telefone:</strong>
                @(Model.Idoso.Tutor != null ? Model.Idoso.Tutor.Telefone : "")
            </p>

            @if (!string.IsNullOrEmpty(Model.Idoso.Tutor?.Telefone))
            {
                var telTutor = new string(
                    Model.Idoso.Tutor.Telefone.Where(char.IsDigit).ToArray()
                );

                <a href="https://wa.me/55@telTutor"
                   target="_blank"
                   class="btn-whatsapp">
                    <i class="fab fa-whatsapp"></i>
                    Chamar Tutor
                </a>
            }

            <hr />

            <h3>Médicos</h3>

            @if (Model.Idoso.Medicos != null && Model.Idoso.Medicos.Any())
            {
                foreach (var medico in Model.Idoso.Medicos)
                {
                    <div class="medico-emergencia">

                        <p>
                            <strong>@medico.Nome</strong>
                        </p>

                        <p>
                            @medico.Telefone
                        </p>

                    </div>
                }
            }
            else
            {
                <p>Nenhum médico cadastrado.</p>
            }

            <div class="acoes-modal">
                <button class="btn-cancelar"
                        onclick="fecharModalEmergencia()">
                    Fechar
                </button>
            </div>

        </div>

    </div>
}

<!-- TOAST -->
<div id="toast" class="toast-custom">
    <i id="toast-icon" class="fas"></i>
    <span id="toast-text"></span>
</div>

<script>
    const idPerfilAvaliado =
        "@(Model.CuidadorDeIdoso?.Id
        ?? Model.Fisioterapeuta?.Id
        ?? Model.Idoso?.Id
        ?? Model.Tutor?.Id)";

    const tipoPerfilAvaliado =
        "@(Model.CuidadorDeIdoso != null ? "Cuidador"
        : Model.Fisioterapeuta != null ? "Fisioterapeuta"
        : Model.Idoso != null ? "Idoso"
        : "Tutor")";
</script>

<script>
    function abrirModalEmergencia() {
        document.getElementById("modalEmergencia").style.display = "flex";
    }

    function fecharModalEmergencia() {
        document.getElementById("modalEmergencia").style.display = "none";
    }
    function mostrarToast(tipo, mensagem) {
        const toast = document.getElementById("toast");
        const icon = document.getElementById("toast-icon");
        const text = document.getElementById("toast-text");

        text.innerText = mensagem;

        toast.className = "toast-custom";

        if (tipo === "sucesso") {
            toast.classList.add("sucesso");
            icon.className = "fas fa-check-circle";
        } else {
            toast.classList.add("info");
            icon.className = "fas fa-exclamation-circle";
        }

        toast.classList.add("show");

        setTimeout(() => {
            toast.classList.remove("show");
        }, 3000);
    }

    function voltarPagina() {
        if (document.referrer !== "") {
            window.history.back();
        } else {
            window.location.href = "/";
        }
    }

    let nota = 0;

    function abrirModalAvaliacao() {
        document.getElementById("modalAvaliacao").style.display = "flex";
    }

    function fecharModal() {
        document.getElementById("modalAvaliacao").style.display = "none";
    }

    const estrelas = document.querySelectorAll("#estrelas i");

    estrelas.forEach((estrela) => {

        estrela.addEventListener("mouseover", function () {
            const valor = this.getAttribute("data-value");

            estrelas.forEach((el, i) => {
                el.classList.toggle("hover", i < valor);
            });
        });

        estrela.addEventListener("mouseout", function () {
            estrelas.forEach(el => el.classList.remove("hover"));
        });

        estrela.addEventListener("click", function () {
            nota = this.getAttribute("data-value");

            estrelas.forEach((el, i) => {
                el.classList.toggle("active", i < nota);
            });
        });
    });

    const textarea = document.getElementById("comentario");
    const count = document.getElementById("count");

    textarea.addEventListener("input", function () {
        count.innerText = this.value.length;
    });

    function enviarAvaliacao() {

        if (nota == 0) {
            alert("Selecione uma nota!");
            return;
        }

        fetch('/Avaliacao/Criar', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                nota: nota,
                comentario: textarea.value,
                idAvaliado: idPerfilAvaliado,
                tipoAvaliado: tipoPerfilAvaliado
            })
        }).then(() => {
            fecharModal();

            // salva o toast antes do reload
            localStorage.setItem("toastTemp", JSON.stringify({
                tipo: "sucesso",
                mensagem: "Avaliação enviada com sucesso!"
            }));

            location.reload();
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        const toastTemp = localStorage.getItem("toastTemp");

        if (toastTemp) {
            const dados = JSON.parse(toastTemp);

            setTimeout(() => {
                mostrarToast(dados.tipo, dados.mensagem);
            }, 300); // espera render da tela

            localStorage.removeItem("toastTemp");
        }
    });

    function adicionarAoQuadro() {

        fetch('/Lembrete/AdicionarAoQuadro', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify({
                nome:
                    "@(Model.Idoso?.Nome
                    ?? Model.Tutor?.Nome)"
            })
        })
        .then(r => r.json())
        .then(data => {

            if (data.sucesso) {

                mostrarToast(
                    "sucesso",
                    data.nome + " adicionado ao quadro."
                );

            } else {

                mostrarToast(
                    "info",
                    data.mensagem
                );
            }
        });
    }

</script>

@if (TempData["ToastMensagem"] != null)
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            mostrarToast(
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["ToastTipo"])),
                @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(TempData["ToastMensagem"]))
            );
        });
    </script>
}

