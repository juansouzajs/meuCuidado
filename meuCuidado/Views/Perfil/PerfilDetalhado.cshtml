        }

    /* BACKGROUND */
    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    /* WRAPPER */
    .perfil-wrapper {
        max-width: 1100px;
        margin: 40px auto;
        padding: 20px;
    }

    /* HEADER */
    .perfil-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .perfil-avatar-wrapper {
        margin-bottom: 15px;
    }

    .perfil-avatar {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        object-fit: cover;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

    .perfil-nome {
        color: #2f6f68;
        font-weight: 600;
    }

    .perfil-subtitle {
        color: #6c8f8b;
        font-size: 14px;
    }

    /* BOTÃO */
    .btn-primary-soft {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-top: 15px;
        padding: 12px 20px;
        background: #4db6ac;
        color: white;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-primary-soft:hover {
            background: #3da59b;
            transform: translateY(-2px);
        }

    /* GRID */
    .perfil-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 20px;
    }

    /* CARD */
    .card-soft {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
    }

    /* LISTA */
    ul {
        list-style: none;
        padding: 0;
    }

        ul li {
            background: #f5f9f8;
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 8px;
        }

    /* AVALIAÇÃO */
    .avaliacao-estrelas {
        display: flex;
        align-items: center;
        gap: 6px;
    }



    .estrela.cheia, .estrela.meia {
        color: #ffc107;
    }

    .estrela.vazia {
        color: #ddd;
    }

    /* MODAL BOX */
    .modal-box {
        background: white;
        padding: 25px;
        border-radius: 16px;
        width: 340px;
        text-align: center;
        box-shadow: 0 15px 40px rgba(0,0,0,0.2);
    }

    /* ESTRELAS */
    .estrelas {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin: 15px 0;
    }

        .estrelas i {
            font-size: 26px;
            color: #ddd;
            cursor: pointer;
            transition: 0.2s;
        }

            .estrelas i.hover,
            .estrelas i.active {
                color: #ffc107;
                transform: scale(1.2);
            }

    /* TEXTAREA */
    textarea {
        width: 100%;
        height: 80px;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #ddd;
        resize: none;
        font-size: 14px;
    }

        textarea:focus {
            outline: none;
            border-color: #4db6ac;
        }

    /* CONTADOR */
    .contador {
        text-align: right;
        font-size: 12px;
        color: #888;
        margin-top: 5px;
    }

    /* BOTÕES */
    .acoes-modal {
        display: flex;
        gap: 10px;
