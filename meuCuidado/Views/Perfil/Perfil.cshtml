@model IEnumerable<UsuarioCardViewModel>
@{
    ViewBag.Title = "Perfil";
    Layout = null;
}

<div class="container perfil-container">
    <h5 style="margin-bottom:15px; color:#2f6f68;">Filtrar perfis</h5>

    <div class="row filtros-card">
        <div class="col-md-3 mb-3">
            <label>Usuário desde</label>
            <input type="date" id="FiltroDataCadastro" class="form-control" />
        </div>

        @if (ViewBag.TipoUsuario != "Cuidador" && ViewBag.TipoUsuario != "Fisioterapeuta")
        {
            <div class="col-md-3 mb-3">
                <label>Profissional</label>
                <select id="FiltroTipoUsuario" class="form-control">
                    <option value="">Todos</option>
                    <option value="1">Cuidador</option>
                    <option value="2">Fisioterapeuta</option>
                </select>
            </div>

            <div class="col-md-3 mb-3">
                <label>Escolaridade</label>
                <select id="FiltroEscolaridade" class="form-control">
                    <option value="">Todos</option>
                    <option value="Ensino Técnico">Ensino Técnico</option>
                    <option value="Ensino Superior">Ensino Superior</option>
                </select>
            </div>
        }

        <div class="col-md-3 mb-3">
            <label>Localização</label>
            <input type="text" id="FiltroLocalizacao" placeholder="Cidade ou região" class="form-control" />
        </div>

        <div class="col-md-3 mb-3 d-flex align-items-end">
            <button id="btnAplicarFiltros" class="btn btn-primary w-100">
                Aplicar Filtros
            </button>
        </div>
    </div>

    <div id="usuariosContainer">
        @Html.Partial("_UsuariosLista", Model)
    </div>
</div>

<style>

    body {
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
        font-family: 'Segoe UI', sans-serif;
    }

    .perfil-container {
        max-width: 1100px;
        margin: 40px auto;
        padding: 0 15px;
    }

    .filtros-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 30px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

        .filtros-card label {
            font-size: 13px;
            color: #4a6f6a;
            margin-bottom: 5px;
            display: block;
        }

    .form-control {
        height: 45px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        padding: 10px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    #btnAplicarFiltros {
        width: 100%;
        height: 45px;
        background: #4db6ac;
        border: none;
        border-radius: 12px;
        color: white;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        #btnAplicarFiltros:hover {
            background: #3da59b;
            transform: translateY(-1px);
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
        }
</style>

<script>
    jQuery(document).ready(function ($) {

        $('#btnAplicarFiltros').click(function () {

            var tipoUsuario = $("#FiltroTipoUsuario").val();
            var dataCadastro = $("#FiltroDataCadastro").val();
            var localizacao = $("#FiltroLocalizacao").val();
            var escolaridade = $("#FiltroEscolaridade").val();

            $.ajax({
                url: '@Url.Action("Filtrar", "Perfil")',
                type: 'GET',
                data: {
                    tipoUsuario: tipoUsuario,
                    dataCadastro: dataCadastro,
                    localizacao: localizacao,
                    escolaridade: escolaridade
                },
                success: function (data) {
                    $('#usuariosContainer').html(data);
                },
                error: function () {
                    alert("Erro ao aplicar os filtros.");
                }
            });
        });

    });
</script>