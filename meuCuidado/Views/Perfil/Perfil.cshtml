@model IEnumerable<meuCuidado.Dominio.Models.Usuario>
@{
    ViewBag.Title = "Perfil";
    Layout = null;
}

<div class="container perfil-container">

    @if (ViewBag.ExibirFiltros == true)
    {
        <div class="row filtros-card">
            <div class="col-md-3 mb-3">
                <label>Usuário do meuCuidado desde</label>
                <input type="date" id="FiltroDataCadastro" class="form-control" />
            </div>

            <div class="col-md-3 mb-3">
                <label>Profissional</label>
                <select id="FiltroTipoUsuario" class="form-control">
                    <option value="">Todos</option>
                    <option value="1">Cuidador</option>
                    <option value="2">Fisioterapeuta</option>
                </select>
            </div>

            <div class="col-md-3 mb-3">
                <label>Localização</label>
                <input type="text" id="FiltroLocalizacao" placeholder="Cidade ou região" class="form-control" />
            </div>

            <div class="col-md-3 mb-3 d-flex align-items-end">
                <button id="btnAplicarFiltros" class="btn btn-primary w-100">
                    Aplicar Filtros
                </button>
            </div>
        </div>
    }

    <div id="usuariosContainer">
        @Html.Partial("_UsuariosLista", Model)
    </div>
</div>

<style>
    .perfil-container {
        max-width: 1200px;
        padding-top: 32px;
    }

    .filtros-card {
        background: #ffffff;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 32px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    }

        .filtros-card label {
            font-size: 0.85rem;
            color: #6c757d;
            margin-bottom: 6px;
            display: block;
        }

        .filtros-card .form-control {
            border-radius: 12px;
        }

    #btnAplicarFiltros {
        border-radius: 12px;
        font-weight: 500;
        height: 38px;
    }
</style>

<!-- jQuery -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    jQuery(document).ready(function ($) {

        $('#btnAplicarFiltros').click(function () {

            var tipoUsuario = $("#FiltroTipoUsuario").val();
            var dataCadastro = $("#FiltroDataCadastro").val();
            var localizacao = $("#FiltroLocalizacao").val();

            $.ajax({
                url: '@Url.Action("Perfil", "Perfil")',
                type: 'GET',
                data: {
                    tipoUsuario: tipoUsuario,
                    dataCadastro: dataCadastro,
                    localizacao: localizacao
                },
                success: function (data) {
                    $('#usuariosContainer').html(data);
                },
                error: function () {
                    alert("Erro ao aplicar os filtros.");
                }
            });
        });

    });
</script>
