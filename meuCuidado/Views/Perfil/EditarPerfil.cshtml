@model meuCuidado.Dominio.ViewModels.PerfilDetalhadoViewModel

@{
    Layout = null;

    var foto = string.IsNullOrEmpty(Model.FotoUrl)
        ? "/ImagensPerfil/default.jpg"
        : Model.FotoUrl;

    var temNecessidades =
        Model.Tutor?.NecessidadesEspeciais
        ?? Model.Idoso?.NecessidadesEspeciais
        ?? false;

    var descricao =
        Model.Tutor?.DescricaoNecessidadesEspeciais
        ?? Model.Idoso?.DescricaoNecessidadesEspeciais
        ?? "";

    var whatsapp =
        Model.CuidadorDeIdoso?.LinkWhatsapp
        ?? Model.Fisioterapeuta?.LinkWhatsapp
        ?? Model.Idoso?.LinkWhatsapp
        ?? Model.Tutor?.LinkWhatsapp;
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="perfil-container">

    <div class="top-bar">
        <button onclick="window.history.back()" class="btn-voltar">
            <i class="fas fa-arrow-left"></i> Voltar
        </button>
    </div>

    <div class="perfil-card">

        <div class="perfil-header">

            <img id="previewFoto"
                 src="@foto"
                 class="perfil-avatar" />

            <h2>
                @(Model.CuidadorDeIdoso?.Nome
                ?? Model.Fisioterapeuta?.Nome
                ?? Model.Idoso?.Nome
                ?? Model.Tutor?.Nome)
            </h2>

            <p class="subtitle">
                Gerencie suas informações
            </p>

            <button class="btn-primary"
                    onclick="toggleEdit()">
                <i class="fas fa-pen"></i>
                Editar Perfil
            </button>

        </div>

        <div class="perfil-body">

            <!-- VISUALIZAÇÃO -->
            <div id="modoVisualizacao">

                @if (!string.IsNullOrEmpty(whatsapp))
                {
                    <h3>Contato</h3>

                    <a href="@whatsapp"
                       target="_blank"
                       class="whatsapp-btn">

                        <i class="fab fa-whatsapp"></i>
                        Conversar no WhatsApp

                    </a>
                }

                @if (Model.Tutor != null || Model.Idoso != null)
                {
                    <h3 style="margin-top:25px;">
                        Necessidades especiais
                    </h3>

                    <p>
                        <strong>Possui:</strong>
                        @(temNecessidades ? "Sim" : "Não")
                    </p>

                    if (temNecessidades && !string.IsNullOrEmpty(descricao))
                    {
                        <div class="necessidades-view">
                            @foreach (var item in descricao.Split(','))
                            {
                                <span class="tag-necessidade">
                                    @item.Trim()
                                </span>
                            }
                        </div>
                    }
                }

            </div>

            <!-- EDIÇÃO -->
            <div id="modoEdicao" style="display:none;">

                <form id="formPerfil"
                      enctype="multipart/form-data">

                    <div class="input-group">
                        <label>Foto de perfil</label>

                        <input type="file"
                               id="inputFoto"
                               name="FotoPerfil"
                               onchange="previewImagem(event)" />
                    </div>

                    <!-- WHATSAPP -->
                    <div class="input-group">

                        <label>
                            Link do WhatsApp (opcional)
                        </label>

                        <input type="text"
                               name="LinkWhatsapp"
                               placeholder="https://wa.me/5599999999999"
                               value="@whatsapp" />

                    </div>

                    <!-- NECESSIDADES -->
                    @if (Model.Tutor != null || Model.Idoso != null)
                    {
                        <div class="input-group">

                            <label>
                                Possui necessidades especiais?
                            </label>

                            <select name="NecessidadesEspeciais"
                                    id="NecessidadesEspeciais"
                                    onchange="toggleNecessidades()">

                                <option value="false"
                                        @(temNecessidades ? "" : "selected")>
                                    Não
                                </option>

                                <option value="true"
                                        @(temNecessidades ? "selected" : "")>
                                    Sim
                                </option>

                            </select>

                        </div>

                        <div id="necessidadesContainer">

                            <label class="switch-label">

                                <input type="checkbox"
                                       id="switchNecessidades"
                                       @(temNecessidades ? "checked" : "")
                                       onchange="toggleListaNecessidades()" />

                                Ativar necessidades especiais

                            </label>

                            <div id="listaNecessidades">

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Ajuda para se locomover" />

                                    <span>Ajuda para se locomover</span>
                                </div>

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Ajuda para tomar banho" />

                                    <span>Ajuda para tomar banho</span>
                                </div>

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Ajuda para alimentação" />

                                    <span>Ajuda para alimentação</span>
                                </div>

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Administração de medicamentos" />

                                    <span>Administração de medicamentos</span>
                                </div>

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Companhia e supervisão" />

                                    <span>Companhia e supervisão</span>
                                </div>

                                <div class="check-item">
                                    <input type="checkbox"
                                           class="necessidade-check"
                                           value="Acompanhamento médico" />

                                    <span>Acompanhamento médico</span>
                                </div>

                                <div class="check-item">

                                    <input type="checkbox"
                                           id="checkOutros"
                                           onchange="toggleOutros()" />

                                    <span>Outros</span>

                                </div>

                                <div id="outrosBox"
                                     style="display:none; margin-top:10px;">

                                    <textarea id="outrosTexto"
                                              placeholder="Digite outras necessidades..."></textarea>

                                </div>

                            </div>

                            <textarea name="DescricaoNecessidadesEspeciais"
                                      id="DescricaoNecessidadesEspeciais"
                                      style="display:none;">@descricao</textarea>

                        </div>
                    }

                    <button type="button"
                            class="btn-primary full"
                            onclick="salvarPerfil()">

                        Salvar alterações

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>

    function toggleEdit() {

        const edit =
            document.getElementById("modoEdicao");

        const view =
            document.getElementById("modoVisualizacao");

        if (!edit || !view)
            return;

        edit.style.display =
            edit.style.display === "none"
                ? "block"
                : "none";

        view.style.display =
            view.style.display === "none"
                ? "block"
                : "none";
    }

    function previewImagem(event) {

        const reader = new FileReader();

        reader.onload = function () {

            const preview =
                document.getElementById("previewFoto");

            if (preview) {
                preview.src = reader.result;
            }
        };

        if (event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }

    function salvarPerfil() {

        atualizarDescricao();

        const form =
            document.getElementById("formPerfil");

        if (!form)
            return;

        const formData =
            new FormData(form);

        fetch('/Perfil/EditarPerfil', {
            method: 'POST',
            body: formData
        })
            .then(() => location.reload())
            .catch(() => alert("Erro ao salvar."));
    }

    function toggleNecessidades() {

        const select =
            document.getElementById("NecessidadesEspeciais");

        const container =
            document.getElementById("necessidadesContainer");

        if (!select || !container)
            return;

        container.style.display =
            select.value === "true"
                ? "block"
                : "none";
    }

    function toggleListaNecessidades() {

        const switchEl =
            document.getElementById("switchNecessidades");

        const lista =
            document.getElementById("listaNecessidades");

        if (!switchEl || !lista)
            return;

        lista.style.display =
            switchEl.checked
                ? "block"
                : "none";

        atualizarDescricao();
    }

    function toggleOutros() {

        const check =
            document.getElementById("checkOutros");

        const box =
            document.getElementById("outrosBox");

        if (!check || !box)
            return;

        box.style.display =
            check.checked
                ? "block"
                : "none";

        atualizarDescricao();
    }

    function atualizarDescricao() {

        const descricaoInput =
            document.getElementById(
                "DescricaoNecessidadesEspeciais"
            );

        if (!descricaoInput)
            return;

        const checks =
            document.querySelectorAll(
                ".necessidade-check:checked"
            );

        let valores = [];

        checks.forEach(c => {
            valores.push(c.value);
        });

        const checkOutros =
            document.getElementById("checkOutros");

        if (checkOutros && checkOutros.checked) {

            const outrosTexto =
                document.getElementById("outrosTexto");

            const texto =
                outrosTexto
                    ? outrosTexto.value
                    : "";

            if (texto.trim() !== "") {

                valores.push(
                    "Outros: " + texto
                );
            }
        }

        descricaoInput.value =
            valores.join(", ");
    }

    document.addEventListener("DOMContentLoaded", function () {

        toggleNecessidades();

        const descricaoInput =
            document.getElementById(
                "DescricaoNecessidadesEspeciais"
            );

        if (!descricaoInput)
            return;

        const descricao =
            descricaoInput.value;

        if (descricao && descricao.trim() !== "") {

            const switchNec =
                document.getElementById(
                    "switchNecessidades"
                );

            const listaNec =
                document.getElementById(
                    "listaNecessidades"
                );

            if (switchNec)
                switchNec.checked = true;

            if (listaNec)
                listaNec.style.display = "block";

            const opcoes = [
                "Ajuda para se locomover",
                "Ajuda para tomar banho",
                "Ajuda para alimentação",
                "Administração de medicamentos",
                "Companhia e supervisão",
                "Acompanhamento médico"
            ];

            opcoes.forEach(opcao => {

                if (descricao.includes(opcao)) {

                    const checkbox =
                        document.querySelector(
                            `.necessidade-check[value="${opcao}"]`
                        );

                    if (checkbox) {
                        checkbox.checked = true;
                    }
                }
            });

            if (descricao.includes("Outros:")) {

                const partes =
                    descricao.split("Outros:");

                const textoOutros =
                    partes[1]?.trim() || "";

                const checkOutros =
                    document.getElementById(
                        "checkOutros"
                    );

                const outrosBox =
                    document.getElementById(
                        "outrosBox"
                    );

                const outrosTexto =
                    document.getElementById(
                        "outrosTexto"
                    );

                if (checkOutros)
                    checkOutros.checked = true;

                if (outrosBox)
                    outrosBox.style.display = "block";

                if (outrosTexto)
                    outrosTexto.value = textoOutros;
            }
        }

        const checks =
            document.querySelectorAll(
                ".necessidade-check"
            );

        checks.forEach(c => {

            c.addEventListener(
                "change",
                atualizarDescricao
            );
        });

        const outros =
            document.getElementById(
                "outrosTexto"
            );

        if (outros) {

            outros.addEventListener(
                "input",
                atualizarDescricao
            );
        }
    });

</script>

<style>

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
    }

    .perfil-container {
        max-width: 700px;
        margin: auto;
        padding: 20px;
    }

    .perfil-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .perfil-header {
        text-align: center;
    }

    .perfil-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #777;
        margin-bottom: 15px;
    }

    .input-group {
        margin-bottom: 15px;
    }

        .input-group input,
        .input-group select,
        textarea {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 1px solid #ccc;
            box-sizing: border-box;
        }

    textarea {
        min-height: 80px;
        resize: vertical;
    }

    .btn-primary {
        background: #4db6ac;
        color: white;
        border: none;
        padding: 12px 18px;
        border-radius: 12px;
        cursor: pointer;
    }

    .btn-voltar {
        padding: 8px 14px;
        border: 1px solid #4db6ac;
        border-radius: 10px;
        background: white;
        color: #4db6ac;
        cursor: pointer;
    }

    .whatsapp-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25d366;
        color: white;
        padding: 10px 16px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

        .whatsapp-btn i {
            font-size: 18px;
        }

    .switch-label {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
        margin-bottom: 15px;
        margin-top: 10px;
    }

    #necessidadesContainer {
        margin-top: 10px;
    }

    #listaNecessidades {
        display: none;
        background: #f7fdfc;
        border: 1px solid #d8ece8;
        padding: 15px;
        border-radius: 14px;
    }

    .check-item {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 12px;
    }

        .check-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
        }

    .necessidades-view {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 10px;
    }

    .tag-necessidade {
        background: #e6f7f4;
        color: #2f7c73;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 14px;
        font-weight: 600;
    }

    #outrosBox textarea {
        margin-top: 10px;
    }
</style>