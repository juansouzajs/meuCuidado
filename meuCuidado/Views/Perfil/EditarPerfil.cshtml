@model meuCuidado.Dominio.ViewModels.PerfilDetalhadoViewModel

@{
    Layout = null;

    var foto = string.IsNullOrEmpty(Model.FotoUrl)
        ? "/ImagensPerfil/default.jpg"
        : Model.FotoUrl;

    var temNecessidades =
        Model.Tutor?.NecessidadesEspeciais
        ?? Model.Idoso?.NecessidadesEspeciais
        ?? false;

    var descricao =
        Model.Tutor?.DescricaoNecessidadesEspeciais
        ?? Model.Idoso?.DescricaoNecessidadesEspeciais
        ?? "";

    var whatsapp =
        Model.CuidadorDeIdoso?.LinkWhatsapp
        ?? Model.Fisioterapeuta?.LinkWhatsapp
        ?? Model.Idoso?.LinkWhatsapp
        ?? Model.Tutor?.LinkWhatsapp;
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<div class="perfil-container">

    <div class="top-bar">
        <button onclick="window.history.back()" class="btn-voltar">
            <i class="fas fa-arrow-left"></i> Voltar
        </button>
    </div>

    <div class="perfil-card">

        <div class="perfil-header">

            <img id="previewFoto" src="@foto" class="perfil-avatar" />

            <h2>
                @(Model.CuidadorDeIdoso?.Nome
                ?? Model.Fisioterapeuta?.Nome
                ?? Model.Idoso?.Nome
                ?? Model.Tutor?.Nome)
            </h2>

            <p class="subtitle">Gerencie suas informações</p>

            <button class="btn-primary" onclick="toggleEdit()">
                <i class="fas fa-pen"></i> Editar Perfil
            </button>

        </div>

        <div class="perfil-body">

            <!-- VISUAL -->
            <div id="modoVisualizacao">

                <!-- WHATSAPP -->
                @if (!string.IsNullOrEmpty(whatsapp))
                {
                    <h3>Contato</h3>

                    <a href="@whatsapp" target="_blank" class="whatsapp-btn">
                        <i class="fab fa-whatsapp"></i> Conversar no WhatsApp
                    </a>
                }

                <!-- NECESSIDADES ESPECIAIS -->
                @if (Model.Tutor != null || Model.Idoso != null)
                {
                    <h3>Necessidades especiais</h3>

                    <p>
                        <strong>Possui:</strong> @(temNecessidades ? "Sim" : "Não")
                    </p>

                    if (temNecessidades && !string.IsNullOrEmpty(descricao))
                    {
                        <p>
                            <strong>Descrição:</strong><br />
                            @descricao
                        </p>
                    }
                }

            </div>

            <!-- EDIÇÃO -->
            <div id="modoEdicao" style="display:none;">

                <form id="formPerfil" enctype="multipart/form-data">

                    <div class="input-group">
                        <label>Foto de perfil</label>
                        <input type="file" id="inputFoto" name="FotoPerfil" onchange="previewImagem(event)" />
                    </div>

                    <!-- WHATSAPP -->
                    <div class="input-group">
                        <label>Link do WhatsApp (opcional)</label>
                        <input type="text"
                               name="LinkWhatsapp"
                               placeholder="https://wa.me/5599999999999"
                               value="@whatsapp" />
                    </div>

                    <!-- NECESSIDADES -->
                    @if (Model.Tutor != null || Model.Idoso != null)
                    {
                        <div class="input-group">
                            <label>Possui necessidades especiais?</label>

                            <select name="NecessidadesEspeciais" id="NecessidadesEspeciais" onchange="toggleDescricao()">
                                <option value="false" @(temNecessidades ? "" : "selected")>Não</option>
                                <option value="true" @(temNecessidades ? "selected" : "")>Sim</option>
                            </select>
                        </div>

                        <div class="input-group" id="descricaoBox">
                            <label>Descrição das necessidades</label>
                            <textarea name="DescricaoNecessidadesEspeciais"
                                      placeholder="Descreva as necessidades especiais...">@descricao</textarea>
                        </div>
                    }

                    <button type="button" class="btn-primary full" onclick="salvarPerfil()">
                        Salvar alterações
                    </button>

                </form>

            </div>

        </div>

    </div>

</div>

<script>
    function toggleEdit() {
        const edit = document.getElementById("modoEdicao");
        const view = document.getElementById("modoVisualizacao");

        edit.style.display = edit.style.display === "none" ? "block" : "none";
        view.style.display = view.style.display === "none" ? "block" : "none";
    }

    function previewImagem(event) {
        const reader = new FileReader();

        reader.onload = function () {
            document.getElementById("previewFoto").src = reader.result;
        };

        if (event.target.files[0]) {
            reader.readAsDataURL(event.target.files[0]);
        }
    }

    function salvarPerfil() {
        const form = document.getElementById("formPerfil");
        const formData = new FormData(form);

        fetch('/Perfil/EditarPerfil', {
            method: 'POST',
            body: formData
        })
            .then(() => location.reload())
            .catch(() => alert("Erro ao salvar."));
    }

    function toggleDescricao() {
        const select = document.getElementById("NecessidadesEspeciais");
        const box = document.getElementById("descricaoBox");

        if (!select || !box) return;

        box.style.display = select.value === "true" ? "block" : "none";
    }

    document.addEventListener("DOMContentLoaded", function () {
        toggleDescricao();
    });
</script>

<style>

    textarea {
        width: 100%;
        min-height: 80px;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #ccc;
        resize: none;
    }

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
    }

    .perfil-container {
        max-width: 700px;
        margin: auto;
        padding: 20px;
    }

    .perfil-card {
        background: white;
        border-radius: 20px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    .perfil-header {
        text-align: center;
    }

    .perfil-avatar {
        width: 130px;
        height: 130px;
        border-radius: 50%;
        object-fit: cover;
        margin-bottom: 10px;
    }

    .subtitle {
        color: #777;
        margin-bottom: 15px;
    }

    .input-group {
        margin-bottom: 15px;
    }

        .input-group input,
        .input-group select {
            width: 100%;
            padding: 10px;
            border-radius: 10px;
            border: 1px solid #ccc;
        }

    .btn-primary {
        background: #4db6ac;
        color: white;
        border: none;
        padding: 10px;
        border-radius: 12px;
        cursor: pointer;
    }

    .btn-voltar {
        padding: 8px 14px;
        border: 1px solid #4db6ac;
        border-radius: 10px;
        background: white;
        color: #4db6ac;
    }

    /* WHATSAPP */
    .whatsapp-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #25d366;
        color: white;
        padding: 10px 16px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
    }

        .whatsapp-btn i {
            font-size: 18px;
        }
</style>