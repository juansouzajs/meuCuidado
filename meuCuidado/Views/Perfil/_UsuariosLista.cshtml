@model IEnumerable<UsuarioCardViewModel>

@if (Model != null && Model.Any())
{
    <div class="usuarios-grid">
        @foreach (var usuario in Model)
        {
            var foto = !string.IsNullOrEmpty(usuario.FotoUrl)
                ? Url.Content(usuario.FotoUrl)
                : "https://i.pinimg.com/564x/ac/0f/41/ac0f419e977af681516e00829c5393ee.jpg";

            <a href="@Url.Action("PerfilDetalhado", "Perfil", new { identificadorUnico = usuario.IdentificadorUnico })"
               class="usuario-card">

                <div class="usuario-img-wrapper">
                    <img src="@foto"
                         alt="Foto do usuário"
                         class="usuario-img" />
                </div>

                <div class="usuario-body">
                    <h5 class="usuario-nome">@usuario.Nome</h5>
                    <p class="usuario-email">@usuario.Email</p>
                </div>

            </a>
        }
    </div>
}
else
{
    <div class="empty-state">
        <h3>Nenhum usuário encontrado</h3>
        <p>Tente ajustar os filtros para encontrar resultados.</p>
    </div>
}

<style>

    /* GRID */
    .usuarios-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: 20px;
        margin-top: 10px;
    }

    /* CARD */
    .usuario-card {
        display: block;
        background: white;
        border-radius: 16px;
        overflow: hidden;
        text-decoration: none;
        color: inherit;
        box-shadow: 0 10px 25px rgba(0,0,0,0.08);
        transition: all 0.25s ease;
    }

        .usuario-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.15);
        }

    /* IMAGEM */
    .usuario-img-wrapper {
        width: 100%;
        height: 200px;
        overflow: hidden;
    }

    .usuario-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.4s ease;
    }

    .usuario-card:hover .usuario-img {
        transform: scale(1.05);
    }

    /* BODY */
    .usuario-body {
        padding: 16px;
    }

    .usuario-nome {
        font-size: 1.1rem;
        font-weight: 600;
        color: #2f6f68;
        margin-bottom: 6px;
    }

    .usuario-email {
        font-size: 0.9rem;
        color: #6c8f8b;
        word-break: break-word;
    }

    /* EMPTY STATE */
    .empty-state {
        text-align: center;
        padding: 60px 20px;
        background: white;
        border-radius: 16px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05);
    }

        .empty-state h3 {
            color: #2f6f68;
            margin-bottom: 10px;
        }

        .empty-state p {
            color: #6c8f8b;
            font-size: 14px;
        }
</style>