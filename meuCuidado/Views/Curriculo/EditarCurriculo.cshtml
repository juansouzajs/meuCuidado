@model meuCuidado.Dominio.Models.Curriculo

@{
    Layout = null;

    var cursos = (Model?.Cursos != null && Model.Cursos.Any())
        ? string.Join(", ", Model.Cursos)
        : "";

    var experiencias = (Model?.Experiencias != null && Model.Experiencias.Any())
        ? string.Join(", ", Model.Experiencias)
        : "";

    var redes = (Model?.RedesSociais != null && Model.RedesSociais.Any())
        ? string.Join(", ", Model.RedesSociais)
        : "";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="curriculo-edit-container">

    <!-- VOLTAR -->
    <div class="top-bar">
        <button type="button" class="btn-voltar" onclick="window.history.back()">
            <i class="fas fa-arrow-left"></i> Voltar
        </button>
    </div>

    <!-- CARD -->
    <div class="curriculo-card">

        <h2>Editar Currículo</h2>

        <form id="formCurriculo">

            <!-- EXPERIÊNCIA -->
            <div class="input-group">
                <label>Anos de experiência</label>
                <input type="number"
                       name="AnosExperiencia"
                       value="@(Model?.AnosExperiencia ?? 0)" />
            </div>

            <!-- ESCOLARIDADE -->
            <div class="input-group">
                <label>Escolaridade</label>
                <input type="text"
                       name="Escolaridade"
                       value="@(Model?.Escolaridade ?? "")" />
            </div>

            <!-- CURSOS -->
            <div class="input-group">
                <label>Cursos (separados por vírgula)</label>
                <input type="text"
                       name="CursosRaw"
                       value="@(cursos)" />
            </div>

            <!-- EXPERIÊNCIAS -->
            <div class="input-group">
                <label>Experiências (separadas por vírgula)</label>
                <input type="text"
                       name="ExperienciasRaw"
                       value="@(experiencias)" />
            </div>

            <!-- REDES -->
            <div class="input-group">
                <label>Redes sociais (separadas por vírgula)</label>
                <input type="text"
                       name="RedesRaw"
                       value="@(redes)" />
            </div>

            <!-- SALVAR -->
            <button type="button" class="btn-salvar" onclick="salvarCurriculo()">
                <i class="fas fa-save"></i> Salvar currículo
            </button>

        </form>

    </div>

</div>

<script>
    function salvarCurriculo() {

        var formData = $("#formCurriculo").serialize();

        $.ajax({
            url: '/Curriculo/SalvarCurriculo',
            type: 'POST',
            data: formData,
            success: function (res) {

                if (res.success) {
                    alert("Currículo salvo com sucesso!");
                    window.history.back();
                } else {
                    alert("Erro ao salvar.");
                    console.log(res.erro);
                }
            },
            error: function (xhr) {
                alert("Erro ao salvar currículo.");
                console.log(xhr.responseText);
            }
        });
    }
</script>

<style>

    body {
        margin: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
    }

    /* CONTAINER */
    .curriculo-edit-container {
        max-width: 750px;
        margin: auto;
        padding: 20px;
    }

    /* TOPO */
    .top-bar {
        margin-bottom: 15px;
    }

    /* CARD */
    .curriculo-card {
        background: white;
        border-radius: 18px;
        padding: 25px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.08);
    }

    h2 {
        text-align: center;
        color: #2f6f68;
        margin-bottom: 20px;
    }

    /* INPUTS */
    .input-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        margin-bottom: 5px;
        font-weight: 600;
        color: #4a6f6a;
    }

    input {
        width: 100%;
        padding: 10px;
        border-radius: 10px;
        border: 1px solid #cfe3df;
        outline: none;
    }

        input:focus {
            border-color: #4db6ac;
            box-shadow: 0 0 0 2px rgba(77,182,172,0.2);
        }

    /* BOTÃO SALVAR */
    .btn-salvar {
        width: 100%;
        padding: 12px;
        background: #4db6ac;
        color: white;
        border: none;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
        margin-top: 10px;
        transition: 0.2s;
    }

        .btn-salvar:hover {
            background: #3da59b;
            transform: translateY(-1px);
        }

    /* BOTÃO VOLTAR */
    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        background: white;
        color: #4db6ac;
        border: 1px solid #4db6ac;
        border-radius: 10px;
        font-weight: 600;
        cursor: pointer;
        transition: 0.2s;
    }

        .btn-voltar:hover {
            background: #4db6ac;
            color: white;
        }
</style>