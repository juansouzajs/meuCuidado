@model meuCuidado.Dominio.Models.Curriculo

@{
    Layout = null;

    var redes = Model?.RedesSociais ?? new List<string>();

    var facebook =
        redes.FirstOrDefault(x => x.ToLower().Contains("facebook")) ?? "";

    var instagram =
        redes.FirstOrDefault(x => x.ToLower().Contains("instagram")) ?? "";

    var linkedin =
        redes.FirstOrDefault(x => x.ToLower().Contains("linkedin")) ?? "";

    var youtube =
        redes.FirstOrDefault(x => x.ToLower().Contains("youtube")) ?? "";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<div class="page">

    <div class="container">

        <!-- HEADER -->
        <div class="header">

            <button class="btn-back"
                    onclick="window.history.back()">

                <i class="fas fa-arrow-left"></i>

            </button>

            <h2>Editar Currículo</h2>

        </div>

        <!-- CARD -->
        <div class="card">

            <form id="formCurriculo">

                <!-- EXPERIÊNCIA -->
                <div class="section">

                    <h3>
                        <i class="fas fa-briefcase"></i>
                        Experiência
                    </h3>

                    <div class="input-group">

                        <label>Anos de experiência</label>

                        <input type="number"
                               name="AnosExperiencia"
                               value="@(Model?.AnosExperiencia ?? 0)" />

                    </div>

                    <div id="expContainer" class="list"></div>

                    <button type="button"
                            class="btn-add"
                            onclick="addExp()">

                        <i class="fas fa-plus"></i>
                        Adicionar experiência

                    </button>

                </div>

                <!-- FORMAÇÃO -->
                <div class="section">

                    <h3>
                        <i class="fas fa-graduation-cap"></i>
                        Formação
                    </h3>

                    <div class="formacao-box">

                        <div class="input-group">

                            <label>Nível de escolaridade</label>

                            <select name="EscolaridadeNivel">

                                <option value="">
                                    Selecione
                                </option>

                                <option value="Outro"
                                        @(Model?.EscolaridadeNivel == "Outro" ? "selected" : "")>

                                    Outro

                                </option>

                                <option value="Ensino Técnico"
                                        @(Model?.EscolaridadeNivel == "Ensino Técnico" ? "selected" : "")>

                                    Ensino Técnico

                                </option>

                                <option value="Ensino Superior"
                                        @(Model?.EscolaridadeNivel == "Ensino Superior" ? "selected" : "")>

                                    Ensino Superior

                                </option>

                            </select>

                        </div>

                        <div class="input-group">

                            <label>
                                Nome da formação
                            </label>

                            <input type="text"
                                   name="EscolaridadeNome"
                                   placeholder="Ex: Técnico em enfermagem"
                                   value="@(Model?.EscolaridadeNome ?? "")" />

                        </div>

                    </div>

                    <hr class="divider" />

                    <h4 class="sub-title">
                        Cursos adicionais
                    </h4>

                    <div id="cursosContainer" class="list"></div>

                    <button type="button"
                            class="btn-add"
                            onclick="addCurso()">

                        <i class="fas fa-plus"></i>
                        Adicionar curso

                    </button>

                </div>

                <!-- REDES -->
                <div class="section">

                    <h3>
                        <i class="fas fa-share-alt"></i>
                        Redes sociais
                    </h3>

                    <div class="social-grid">

                        <div class="social-input">

                            <i class="fab fa-facebook"></i>

                            <input name="Facebook"
                                   value="@facebook"
                                   placeholder="https://facebook.com/seu.usuario">

                        </div>

                        <div class="social-input">

                            <i class="fab fa-instagram"></i>

                            <input name="Instagram"
                                   value="@instagram"
                                   placeholder="https://instagram.com/seu.usuario">

                        </div>

                        <div class="social-input">

                            <i class="fab fa-linkedin"></i>

                            <input name="Linkedin"
                                   value="@linkedin"
                                   placeholder="https://linkedin.com/in/seu.usuario">

                        </div>

                        <div class="social-input">

                            <i class="fab fa-youtube"></i>

                            <input name="Youtube"
                                   value="@youtube"
                                   placeholder="https://youtube.com/seucanal">

                        </div>

                    </div>

                </div>

                <!-- BOTÃO -->
                <button type="button"
                        class="btn-save"
                        onclick="salvarCurriculo()">

                    <i class="fas fa-save"></i>
                    Salvar currículo

                </button>

            </form>

        </div>

    </div>

</div>

<script>

    function addCurso(valor = "") {

        $("#cursosContainer").append(`
            <div class="list-item fade-in">

                <input type="text"
                       name="Cursos"
                       value="${valor}"
                       placeholder="Ex: Curso de primeiros socorros">

                <button type="button"
                        onclick="$(this).parent().remove()">

                    <i class="fas fa-times"></i>

                </button>

            </div>
        `);
    }

    function addExp(valor = "") {

        $("#expContainer").append(`
            <div class="list-item fade-in">

                <input type="text"
                       name="Experiencias"
                       value="${valor}"
                       placeholder="Ex: Cuidador de idosos por 2 anos">

                <button type="button"
                        onclick="$(this).parent().remove()">

                    <i class="fas fa-times"></i>

                </button>

            </div>
        `);
    }

    function salvarCurriculo() {

        var data =
            $("#formCurriculo").serialize();

        $.ajax({

            url: '/Curriculo/SalvarCurriculo',

            type: 'POST',

            data: data,

            success: function (res) {

                if (res.success) {

                    alert("Salvo com sucesso!");

                    window.history.back();

                } else {

                    alert(res.erro);
                }
            },

            error: function (xhr) {

                console.log(xhr.responseText);

                alert("Erro ao salvar.");
            }
        });
    }

    $(document).ready(function () {

        var cursos =
            @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model?.Cursos ?? new List<string>()
                )
            );

        var experiencias =
            @Html.Raw(
                Newtonsoft.Json.JsonConvert.SerializeObject(
                    Model?.Experiencias ?? new List<string>()
                )
            );

        if (cursos.length > 0) {

            cursos.forEach(c => addCurso(c));

        } else {

            addCurso();
        }

        if (experiencias.length > 0) {

            experiencias.forEach(e => addExp(e));

        } else {

            addExp();
        }
    });

</script>

<style>

    body {
        margin: 0;
        font-family: 'Segoe UI';
        background: linear-gradient(135deg, #e6f4f1, #f8fbff);
    }

    .page {
        padding: 30px;
    }

    .container {
        max-width: 750px;
        margin: auto;
    }

    .header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }

        .header h2 {
            color: #2f6f68;
            font-size: 22px;
        }

    .btn-back {
        border: none;
        background: white;
        border-radius: 10px;
        padding: 10px 14px;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }

    .card {
        background: white;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
    }

    .section {
        margin-bottom: 30px;
    }

        .section h3 {
            margin-bottom: 15px;
            color: #2f6f68;
            display: flex;
            align-items: center;
            gap: 8px;
        }

    .sub-title {
        margin-bottom: 15px;
        color: #2f6f68;
    }

    .divider {
        margin: 25px 0;
        border: none;
        border-top: 1px solid #e3efec;
    }

    .input-group {
        margin-bottom: 15px;
    }

        .input-group input,
        .input-group select {
            width: 100%;
            padding: 12px;
            border-radius: 12px;
            border: 1px solid #cfe3df;
            box-sizing: border-box;
        }

    .list-item {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }

        .list-item input {
            flex: 1;
        }

        .list-item button {
            background: #ff6b6b;
            border: none;
            color: white;
            border-radius: 10px;
            padding: 8px 12px;
            cursor: pointer;
        }

    .btn-add {
        margin-top: 10px;
        background: #e0f2f1;
        border: none;
        padding: 10px 14px;
        border-radius: 12px;
        cursor: pointer;
        font-weight: 600;
    }

    .social-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .social-input {
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid #cfe3df;
        border-radius: 12px;
        padding: 10px;
    }

        .social-input input {
            border: none;
            outline: none;
            width: 100%;
        }

    .btn-save {
        width: 100%;
        padding: 16px;
        background: #4db6ac;
        color: white;
        border: none;
        border-radius: 16px;
        font-size: 16px;
        cursor: pointer;
        transition: 0.2s;
        margin-top: 10px;
    }

        .btn-save:hover {
            background: #3da59b;
            transform: translateY(-2px);
        }

    .fade-in {
        animation: fadeIn 0.2s ease-in-out;
    }

    @@keyframes fadeIn {

        from {
            opacity: 0;
            transform: translateY(5px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>