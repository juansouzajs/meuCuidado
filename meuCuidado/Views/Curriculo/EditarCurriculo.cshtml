@model meuCuidado.Dominio.Models.Curriculo

<div class="container curriculo-detalhes-container">
    <div class="card curriculo-detalhes-card">
        <div class="card-body">

            <!-- Informações principais -->
            <div class="info-bloco">
                <p><strong>Cuidadora de idosos há:</strong> @Model.AnosExperiencia anos</p>
                <p><strong>Escolaridade:</strong> @Model.Escolaridade</p>
            </div>

            <!-- Cursos -->
            @if (Model.Cursos != null && Model.Cursos.Any())
            {
                <div class="info-bloco">
                    <h4>Cursos</h4>
                    <ul>
                        @foreach (var curso in Model.Cursos)
                        {
                            <li>@curso</li>
                        }
                    </ul>
                </div>
            }

            <!-- Experiências -->
            @if (Model.Experiencias != null && Model.Experiencias.Any())
            {
                <div class="info-bloco">
                    <h4>Experiência</h4>
                    <ul>
                        @foreach (var experiencia in Model.Experiencias)
                        {
                            <li>@experiencia</li>
                        }
                    </ul>
                </div>
            }

            <!-- Redes sociais -->
            @if (Model.RedesSociais != null && Model.RedesSociais.Any())
            {
                <div class="info-bloco redes-sociais">
                    <h4>Redes Sociais</h4>

                    @foreach (var rede in Model.RedesSociais)
                    {
                        if (rede.Contains("linkedin"))
                        {
                            <a href="@rede" target="_blank" title="LinkedIn">
                                <i class="fa fa-linkedin"></i>
                            </a>
                        }
                        else if (rede.Contains("facebook"))
                        {
                            <a href="@rede" target="_blank" title="Facebook">
                                <i class="fa fa-facebook"></i>
                            </a>
                        }
                        else if (rede.Contains("instagram"))
                        {
                            <a href="@rede" target="_blank" title="Instagram">
                                <i class="fa fa-instagram"></i>
                            </a>
                        }
                    }
                </div>
            }

        </div>
    </div>

    <!-- Botão voltar -->
    <div class="voltar-container">
        <a href="@Url.Action("Configuracoes", "Configuracoes")" class="btn-voltar">
            <i class="fa fa-arrow-left"></i> Voltar
        </a>
    </div>
</div>

<style>
    .curriculo-detalhes-container {
        max-width: 650px;
        margin: 40px auto;
    }

    .curriculo-detalhes-card {
        border-radius: 12px;
        background-color: #f5f5f5;
        box-shadow: 0 4px 8px rgba(0,0,0,0.08);
    }

    .card-body {
        padding: 25px;
    }

    .info-bloco {
        margin-bottom: 25px;
    }

        .info-bloco h4 {
            margin-bottom: 10px;
            color: #555;
        }

    ul {
        padding-left: 20px;
    }

        ul li {
            margin-bottom: 6px;
        }

    /* Redes sociais */
    .redes-sociais a {
        font-size: 28px;
        margin-right: 15px;
        color: #555;
        transition: color 0.2s;
    }

        .redes-sociais a:hover {
            color: #007bff;
        }

    /* Botão voltar */
    .voltar-container {
        margin-top: 30px;
        text-align: center;
    }

    .btn-voltar {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 2px solid #007bff;
        color: #007bff;
        padding: 10px 24px;
        border-radius: 25px;
        font-size: 16px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

        .btn-voltar:hover {
            background-color: #007bff;
            color: #fff;
            box-shadow: 0 4px 8px rgba(0, 123, 255, 0.4);
        }
</style>
