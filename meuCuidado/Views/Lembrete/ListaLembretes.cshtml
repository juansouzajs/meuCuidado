@model IList<meuCuidado.Dominio.Models.Lembrete>

<table class="table-lembretes">

    <thead>
        <tr>
            <th>Descrição</th>
            <th>Data e Hora</th>
            <th>Medicamento</th>
            <th>Ações</th>
        </tr>
    </thead>

    <tbody>

        @if (!Model.Any())
        {
            <tr>
                <td colspan="4">Nenhum lembrete</td>
            </tr>
        }
        else
        {
            foreach (var item in Model)
            {
                <tr class="lembrete-item"
                    data-id="@item.Id"
                    data-datetime="@item.DataHora.ToString("yyyy-MM-ddTHH:mm:ss")"
                    data-descricao="@item.Descricao">

                    <td>@item.Descricao</td>

                    <td>
                        @item.DataHora.ToString("dd/MM/yyyy HH:mm")
                    </td>

                    <td>
                        @(item.Medicamento != null
                        ? item.Medicamento.Nome + " " + item.Medicamento.Dosagem
                        : "-")
                    </td>

                    <td>
                        <button class="btn-delete"
                                onclick="excluirLembrete(@item.Id)">
                            🗑️
                        </button>
                    </td>

                </tr>
            }
        }

    </tbody>

</table>


<style>

    .table-lembretes {
        width: 100%;
        border-collapse: collapse;
    }

        .table-lembretes th {
            background: #f0f8ff;
            padding: 10px;
        }

        .table-lembretes td {
            padding: 10px;
            border-bottom: 1px solid #eee;
        }

    .btn-delete {
        background: white;
        border: 2px solid #ff4d4d;
        color: #ff4d4d;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        cursor: pointer;
        font-size: 16px;
        transition: 0.2s;
    }

        .btn-delete:hover {
            background: #ff4d4d;
            color: white;
            transform: scale(1.1);
        }
</style>