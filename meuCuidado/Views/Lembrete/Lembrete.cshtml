@model IList<meuCuidado.Dominio.Models.Lembrete>

@{
    ViewBag.Title = "Lembretes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cadastro-container">
    <div class="cadastro-card">

        <h2 class="cadastro-titulo">Lembretes</h2>

        <!-- Seletor de pessoa -->
        <div class="top-bar">
            <select id="selectPessoa" class="input-padrao">
                <option value="Todos">Todos</option>
                <option value="Maria">Maria</option>
                <option value="Josefa">Josefa</option>
                <option value="Abraão">Abraão</option>
            </select>

            <button id="addPersonButton" class="btn-padrao btn-add">+</button>
        </div>

        <!-- Calendário -->
        <div id="calendar" class="calendar-card">
            <div class="calendar-header">
                <button id="prevMonth" class="btn-padrao">&lt;</button>
                <h4 id="monthYear"></h4>
                <button id="nextMonth" class="btn-padrao">&gt;</button>
            </div>

            <div class="calendar-grid" id="calendarGrid"></div>
        </div>

        <!-- Lista de lembretes -->
        <div id="ListaLembretesContainer">
            @Html.Partial("ListaLembretes", Model)
        </div>

        <!-- Formulário -->
        <div class="form-area">
            <h3>Adicionar Lembrete</h3>

            <form id="addReminderForm">
                <div class="campo">
                    <label>Descrição</label>
                    <input type="text" class="input-padrao" id="descricao" required />
                </div>

                <div class="campo">
                    <label>Hora do Lembrete</label>
                    <input type="time" class="input-padrao" id="dataHora" required />
                </div>

                <div class="campo">
                    <label>Medicamento (Opcional)</label>
                    <select class="input-padrao" id="MedicamentoId">
                        <option value="">Nenhum</option>
                        @foreach (var medicamento in ViewBag.Medicamentos)
                        {
                            <option value="@medicamento.Id">@medicamento.Nome</option>
                        }
                    </select>
                </div>

                <div class="campo">
                    <label>Dosagem (Opcional)</label>
                    <select class="input-padrao" id="DosagemId">
                        <option value="">Nenhum</option>
                        @foreach (var medicamento in ViewBag.Medicamentos)
                        {
                            <option value="@medicamento.Id">@medicamento.Dosagem</option>
                        }
                    </select>
                </div>

                <div class="acoes">
                    <button type="button" class="btn-link"
                            onclick="window.location.href='@Url.Action("AdicionarMedicamento", "Medicamento")'">
                        + Adicionar Novo Medicamento
                    </button>

                    <button type="submit" class="btn-padrao">
                        Adicionar Lembrete
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>

<style>
    body {
        background-color: #f0f8ff;
        font-family: Arial, sans-serif;
    }

    .cadastro-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px;
    }

    .cadastro-card {
        background-color: white;
        padding: 30px;
        border-radius: 12px;
        width: 100%;
        max-width: 850px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
    }

    .cadastro-titulo {
        text-align: center;
        color: #5a9fa8;
        margin-bottom: 20px;
    }

    .input-padrao {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #a8dadc;
        margin-bottom: 10px;
    }

    .btn-padrao {
        background-color: #a8dadc;
        color: white;
        border: none;
        padding: 10px 15px;
        border-radius: 8px;
        cursor: pointer;
    }

        .btn-padrao:hover {
            background-color: #5a9fa8;
        }

    .top-bar {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 20px;
    }

    .calendar-card {
        background: #ffffff;
        border-radius: 10px;
        padding: 20px;
        border: 1px solid #a8dadc;
        margin-bottom: 20px;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        text-align: center;
    }

    .day {
        padding: 10px;
        background: #f0f8ff;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #a8dadc;
    }

        .day.selected {
            background-color: #a8dadc;
            color: white;
            font-weight: bold;
        }

    .campo {
        margin-bottom: 15px;
    }

    .acoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .btn-link {
        background: none;
        border: none;
        color: #5a9fa8;
        cursor: pointer;
        text-decoration: underline;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {

        let currentMonth = new Date();
        let selectedDate = '';
        const monthYear = $('#monthYear');
        const calendarGrid = $('#calendarGrid');

        function renderCalendar() {
            monthYear.text(currentMonth.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }));
            calendarGrid.html('');

            const firstDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);
            const lastDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0);

            for (let i = 0; i < firstDay.getDay(); i++) {
                calendarGrid.append('<div></div>');
            }

            for (let day = 1; day <= lastDay.getDate(); day++) {
                const date = `${currentMonth.getFullYear()}-${String(currentMonth.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const div = $(`<div class="day">${day}</div>`);

                div.click(function () {
                    $('.day').removeClass('selected');
                    $(this).addClass('selected');
                    selectedDate = date;
                    loadReminders(date);
                });

                calendarGrid.append(div);
            }
        }

        $('#prevMonth').click(() => {
            currentMonth.setMonth(currentMonth.getMonth() - 1);
            renderCalendar();
        });

        $('#nextMonth').click(() => {
            currentMonth.setMonth(currentMonth.getMonth() + 1);
            renderCalendar();
        });

        function loadReminders(date) {
            $('#ListaLembretesContainer').load(`/Lembrete/GetReminders?date=${date}`);
        }

        $('#addReminderForm').submit(function (e) {
            e.preventDefault();

            fetch('/Lembrete/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Descricao: $('#descricao').val(),
                    DataHora: selectedDate + 'T' + $('#dataHora').val(),
                    MedicamentoId: $('#MedicamentoId').val() || null,
                    DosagemId: $('#DosagemId').val() || null
                })
            }).then(() => {
                this.reset();
                renderCalendar();
            });
        });

        renderCalendar();
    });
</script>
