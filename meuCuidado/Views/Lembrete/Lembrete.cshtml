@model IList<meuCuidado.Dominio.Models.Lembrete>

@{
    ViewBag.Title = "Lembretes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container lembretes-container">

    <!-- Seletor de pessoa -->
    <div class="top-bar">
        <select id="selectPessoa" class="form-control select-pessoa">
            <option value="Todos">Todos</option>
            <option value="Maria">Maria</option>
            <option value="Josefa">Josefa</option>
            <option value="Abraão">Abraão</option>
        </select>

        <button id="addPersonButton" class="btn btn-add">+</button>
    </div>

    <!-- Calendário -->
    <div id="calendar" class="calendar-card">
        <div class="calendar-header">
            <button id="prevMonth" class="calendar-btn">&lt;</button>
            <h4 id="monthYear"></h4>
            <button id="nextMonth" class="calendar-btn">&gt;</button>
        </div>

        <div class="calendar-grid" id="calendarGrid"></div>
    </div>

    <!-- Lista de lembretes -->
    <div id="ListaLembretesContainer" class="lista-lembretes">
        @Html.Partial("ListaLembretes", Model)
    </div>

    <!-- Formulário -->
    <div class="card form-card">
        <div class="card-body">
            <h4>Adicionar Lembrete</h4>

            <form id="addReminderForm">
                <div class="form-group">
                    <label>Descrição</label>
                    <input type="text" class="form-control" id="descricao" required />
                </div>

                <div class="form-group">
                    <label>Hora do Lembrete</label>
                    <input type="time" class="form-control" id="dataHora" required />
                </div>

                <div class="form-group">
                    <label>Medicamento (Opcional)</label>
                    <select class="form-control" id="MedicamentoId">
                        <option value="">Nenhum</option>
                        @foreach (var medicamento in ViewBag.Medicamentos)
                        {
                            <option value="@medicamento.Id">@medicamento.Nome</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label>Dosagem (Opcional)</label>
                    <select class="form-control" id="DosagemId">
                        <option value="">Nenhum</option>
                        @foreach (var medicamento in ViewBag.Medicamentos)
                        {
                            <option value="@medicamento.Id">@medicamento.Dosagem</option>
                        }
                    </select>
                </div>

                <div class="acoes">
                    <button type="button" class="btn btn-link"
                            onclick="window.location.href='@Url.Action("AdicionarMedicamento", "Medicamento")'">
                        + Adicionar Novo Medicamento
                    </button>

                    <button type="submit" class="btn btn-primary">
                        Adicionar Lembrete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .lembretes-container {
        max-width: 900px;
        margin: 30px auto;
    }

    .top-bar {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .select-pessoa {
        width: auto;
    }

    .btn-add {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background-color: #a8dadc;
        color: white;
        border: none;
        font-size: 20px;
        line-height: 0;
    }

        .btn-add:hover {
            background-color: #5a9fa8;
        }

    .calendar-card {
        background: #f5f5f5;
        border-radius: 10px;
        padding: 20px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        margin-bottom: 30px;
    }

    .calendar-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .calendar-btn {
        background-color: #a8dadc;
        border: none;
        color: white;
        padding: 6px 12px;
        font-size: 18px;
        border-radius: 5px;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
        text-align: center;
    }

    .day {
        padding: 10px;
        background: white;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid #ddd;
    }

        .day.selected {
            background-color: #a8dadc;
            color: white;
            font-weight: bold;
        }

    .lista-lembretes {
        margin-bottom: 30px;
    }

    .form-card {
        border-radius: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
    }

    .acoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        let currentMonth = new Date();
        let selectedDate = '';
        const monthYear = $('#monthYear');
        const calendarGrid = $('#calendarGrid');

        function renderCalendar() {
            monthYear.text(currentMonth.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' }));
            calendarGrid.html('');

            const firstDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);
            const lastDay = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 0);

            for (let i = 0; i < firstDay.getDay(); i++) {
                calendarGrid.append('<div></div>');
            }

            for (let day = 1; day <= lastDay.getDate(); day++) {
                const date = `${currentMonth.getFullYear()}-${String(currentMonth.getMonth() + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                const div = $(`<div class="day">${day}</div>`);

                div.click(function () {
                    $('.day').removeClass('selected');
                    $(this).addClass('selected');
                    selectedDate = date;
                    loadReminders(date);
                });

                calendarGrid.append(div);
            }
        }

        $('#prevMonth').click(() => {
            currentMonth.setMonth(currentMonth.getMonth() - 1);
            renderCalendar();
        });

        $('#nextMonth').click(() => {
            currentMonth.setMonth(currentMonth.getMonth() + 1);
            renderCalendar();
        });

        function loadReminders(date) {
            $('#ListaLembretesContainer').load(`/Lembrete/GetReminders?date=${date}`);
        }

        $('#addReminderForm').submit(function (e) {
            e.preventDefault();

            fetch('/Lembrete/Create', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    Descricao: $('#descricao').val(),
                    DataHora: selectedDate + 'T' + $('#dataHora').val(),
                    MedicamentoId: $('#MedicamentoId').val() || null,
                    DosagemId: $('#DosagemId').val() || null
                })
            }).then(() => {
                this.reset();
                renderCalendar();
            });
        });

        renderCalendar();
    });
</script>
