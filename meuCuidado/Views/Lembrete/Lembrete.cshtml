@model IList<meuCuidado.Dominio.Models.Lembrete>

@{
    ViewBag.Title = "Lembretes";
    Layout = null;
}

<div class="cadastro-container">

    <div class="cadastro-card">

        <h2 class="cadastro-titulo">Lembretes</h2>

        <!-- Pessoa -->
        <div class="top-bar">

            <select id="selectPessoa" class="input-padrao">

                <option value="">Todos</option>

                @foreach (var pessoa in ViewBag.Pessoas)
                {
                    <option value="@pessoa.Id">
                        @pessoa.Nome
                    </option>
                }

            </select>

            <button type="button"
                    id="addPersonButton"
                    class="btn-padrao btn-add">

                +

            </button>

        </div>

        <!-- Calendário -->
        <div class="calendar-card">

            <div class="calendar-header">

                <button type="button"
                        id="prevMonth"
                        class="btn-padrao nav-btn">

                    &lt;

                </button>

                <h4 id="monthYear"></h4>

                <button type="button"
                        id="nextMonth"
                        class="btn-padrao nav-btn">

                    &gt;

                </button>

            </div>

            <div id="calendarGrid" class="calendar-grid"></div>

        </div>

        <!-- Lista -->
        <div id="ListaLembretesContainer">

            @Html.Partial("ListaLembretes", Model)

        </div>

        <!-- Form -->
        <div class="form-area">

            <h3>Adicionar Lembrete</h3>

            <form id="addReminderForm">

                <div class="campo">

                    <label>Descrição</label>

                    <input type="text"
                           id="descricao"
                           class="input-padrao"
                           required />

                </div>

                <div class="campo">

                    <label>Hora</label>

                    <input type="time"
                           id="dataHora"
                           class="input-padrao"
                           required />

                </div>

                <div class="campo">

                    <label>Medicamento</label>

                    <select id="MedicamentoId"
                            class="input-padrao">

                        <option value="">Nenhum</option>

                        @foreach (var medicamento in ViewBag.Medicamentos)
                        {
                            <option value="@medicamento.Id">
                                @medicamento.Nome @medicamento.Dosagem
                            </option>
                        }

                    </select>

                </div>

                <div class="acoes">

                    <button type="button"
                            class="btn-link"
                            onclick="window.location.href='@Url.Action("AdicionarMedicamento", "Medicamento")'">

                        + Novo medicamento

                    </button>

                    <button type="submit"
                            class="btn-padrao">

                        Adicionar

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

<!-- Modal -->
<div id="personModal" class="modal-overlay">

    <div class="modal-card">

        <h3>Adicionar Pessoa</h3>

        <input type="text"
               id="novaPessoaNome"
               class="input-padrao"
               placeholder="Digite o nome" />

        <div class="modal-actions">

            <button type="button"
                    id="cancelPersonModal"
                    class="btn-cancelar">

                Cancelar

            </button>

            <button type="button"
                    id="savePersonModal"
                    class="btn-padrao">

                Salvar

            </button>

        </div>

    </div>

</div>

<div id="toast" class="toast"></div>

<audio id="notificationSound">
    <source src="https://actions.google.com/sounds/v1/alarms/alarm_clock.ogg">
</audio>

<style>

    body {
        background: #eef7fb;
        font-family: Arial, sans-serif;
        margin: 0;
    }

    .cadastro-container {
        display: flex;
        justify-content: center;
        padding: 40px 20px;
    }

    .cadastro-card {
        background: white;
        width: 880px;
        border-radius: 14px;
        padding: 28px 32px;
        box-shadow: 0 6px 18px rgba(90,159,168,0.15);
        border: 1px solid #e3f2f4;
    }

    .cadastro-titulo {
        text-align: center;
        color: #5a9fa8;
        margin-bottom: 20px;
    }

    .top-bar {
        display: flex;
        gap: 10px;
        margin-bottom: 20px;
    }

    .input-padrao {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #a8dadc;
        box-sizing: border-box;
    }

    .btn-padrao {
        background: #a8dadc;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px 16px;
        cursor: pointer;
    }

        .btn-padrao:hover {
            background: #5a9fa8;
        }

    .btn-add {
        width: 44px;
        min-width: 44px;
        border-radius: 50%;
        font-size: 18px;
    }

    .btn-link {
        border: none;
        background: none;
        color: #5a9fa8;
        cursor: pointer;
    }

    .calendar-card {
        background: #fafdfe;
        border: 1px solid #a8dadc;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .calendar-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .nav-btn {
        border-radius: 50%;
        width: 40px;
        height: 40px;
        padding: 0;
    }

    #monthYear {
        color: #5a9fa8;
        margin: 0;
        text-transform: capitalize;
    }

    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 8px;
    }

    .day {
        background: #f0f8ff;
        border: 1px solid #d6eef2;
        border-radius: 8px;
        padding: 12px;
        text-align: center;
        cursor: pointer;
        transition: 0.2s;
    }

        .day:hover {
            background: #dff3f5;
        }

        .day.selected {
            background: #5a9fa8;
            color: white;
            border-color: #5a9fa8;
        }

    .empty-day {
        visibility: hidden;
    }

    .form-area {
        border-top: 1px solid #e3f2f4;
        padding-top: 20px;
    }

    .campo {
        margin-bottom: 14px;
    }

        .campo label {
            display: block;
            margin-bottom: 5px;
            color: #5a9fa8;
        }

    .acoes {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 14px;
    }

    .toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: #a8dadc;
        color: white;
        padding: 14px 20px;
        border-radius: 10px;
        opacity: 0;
        transform: translateY(20px);
        transition: 0.3s;
        z-index: 99999;
    }

        .toast.show {
            opacity: 1;
            transform: translateY(0);
        }

        .toast.error {
            background: #f4a3a3;
        }

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.35);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-card {
        width: 380px;
        background: white;
        border-radius: 14px;
        padding: 24px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    }

        .modal-card h3 {
            margin-top: 0;
            color: #5a9fa8;
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .btn-cancelar {
        border: none;
        background: #ececec;
        border-radius: 8px;
        padding: 10px 16px;
        cursor: pointer;
    }
</style>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    let today = new Date();

    let selectedDate =
        today.getFullYear() + "-" +
        String(today.getMonth() + 1).padStart(2, "0") + "-" +
        String(today.getDate()).padStart(2, "0");

    function showToast(message, error = false) {

        let toast = $("#toast");

        toast.text(message);

        toast.removeClass("error");

        if (error) {
            toast.addClass("error");
        }

        toast.addClass("show");

        setTimeout(function () {
            toast.removeClass("show");
        }, 3000);
    }

    function loadReminders(date) {

        selectedDate = date;

        let pessoaId = $("#selectPessoa").val();

        $("#ListaLembretesContainer").load(
            "/Lembrete/GetReminders?date=" +
            encodeURIComponent(date) +
            "&pessoaId=" +
            encodeURIComponent(pessoaId || "")
        );
    }

    function excluirLembrete(id) {

        fetch("/Lembrete/Excluir", {
            method: "POST",
            headers: {
                "Content-Type": "application/json"
            },
            body: JSON.stringify({
                id: id
            })
        })
            .then(r => r.json())
            .then(res => {

                if (res.success) {

                    showToast("Excluído com sucesso");

                    loadReminders(selectedDate);

                } else {

                    showToast("Erro ao excluir", true);

                }

            });
    }

    $(function () {

        $("#selectPessoa").on("change", function () {

            loadReminders(selectedDate);

        });

        // MODAL

        $("#addPersonButton").on("click", function () {

            $("#personModal").addClass("show");

            $("#novaPessoaNome").val("");

            setTimeout(function () {

                $("#novaPessoaNome").focus();

            }, 100);

        });

        $("#cancelPersonModal").on("click", function () {

            $("#personModal").removeClass("show");

        });

        $("#savePersonModal").on("click", function () {

            let nome = $("#novaPessoaNome").val().trim();

            if (nome === "") {

                showToast("Digite um nome", true);

                return;

            }

            fetch("/Lembrete/CreatePessoa", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    Nome: nome
                })

            })
                .then(r => r.json())
                .then(res => {

                    if (res.success) {

                        $("#selectPessoa").append(
                            `<option value="${res.id}">
                            ${nome}
                        </option>`
                        );

                        $("#selectPessoa")
                            .val(res.id)
                            .trigger("change");

                        $("#personModal").removeClass("show");

                        showToast("Pessoa adicionada");

                    } else {

                        showToast(res.error || "Erro ao adicionar pessoa", true);

                    }

                });

        });

        // CALENDÁRIO

        let currentMonth = new Date();

        function renderCalendar() {

            $("#monthYear").text(

                currentMonth.toLocaleDateString("pt-BR", {
                    month: "long",
                    year: "numeric"
                })

            );

            $("#calendarGrid").html("");

            let year = currentMonth.getFullYear();

            let month = currentMonth.getMonth();

            let firstDay = new Date(year, month, 1);

            let lastDay = new Date(year, month + 1, 0);

            let startDay = firstDay.getDay();

            if (startDay === 0) {
                startDay = 7;
            }

            startDay--;

            for (let i = 0; i < startDay; i++) {

                $("#calendarGrid").append(
                    `<div class="empty-day"></div>`
                );

            }

            for (let day = 1; day <= lastDay.getDate(); day++) {

                let date =
                    year + "-" +
                    String(month + 1).padStart(2, "0") + "-" +
                    String(day).padStart(2, "0");

                let dayDiv = $(`
                    <div class="day">
                        ${day}
                    </div>
                `);

                if (date === selectedDate) {
                    dayDiv.addClass("selected");
                }

                dayDiv.on("click", function () {

                    $(".day").removeClass("selected");

                    $(this).addClass("selected");

                    loadReminders(date);

                });

                $("#calendarGrid").append(dayDiv);

            }
        }

        $("#prevMonth").on("click", function () {

            currentMonth.setMonth(
                currentMonth.getMonth() - 1
            );

            renderCalendar();

        });

        $("#nextMonth").on("click", function () {

            currentMonth.setMonth(
                currentMonth.getMonth() + 1
            );

            renderCalendar();

        });

        // CREATE LEMBRETE

        $("#addReminderForm").on("submit", function (e) {

            e.preventDefault();

            fetch("/Lembrete/Create", {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({

                    Descricao: $("#descricao").val(),

                    DataHora:
                        selectedDate + "T" + $("#dataHora").val(),

                    MedicamentoId:
                        $("#MedicamentoId").val() || null,

                    PessoaId:
                        $("#selectPessoa").val() || null

                })

            })
                .then(r => r.json())
                .then(res => {

                    if (res.success) {

                        showToast("Criado com sucesso");

                        $("#addReminderForm")[0].reset();

                        loadReminders(selectedDate);

                    } else {

                        showToast(
                            res.error || "Erro ao criar",
                            true
                        );

                    }

                });

        });

        renderCalendar();

        loadReminders(selectedDate);

    });

</script>