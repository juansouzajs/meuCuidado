@model meuCuidado.Dominio.Models.Medicamento

@{
    ViewBag.Title = "Adicionar Medicamento";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="cadastro-container">
    <div class="cadastro-card">

        <h2 class="cadastro-titulo">Adicionar Medicamento</h2>

        <form asp-action="AdicionarMedicamento" asp-controller="Medicamento" method="post">

            <div class="campo">
                <label for="Nome">Nome do Medicamento</label>
                <input type="text" class="input-padrao" id="Nome" name="Nome" required />
            </div>

            <div class="campo">
                <label for="Dosagem">Dosagem</label>
                <input type="text" class="input-padrao" id="Dosagem" name="Dosagem" required />
            </div>

            <div class="campo">
                <label for="DataHoraPrimeiroAlerta">Primeiro Alerta</label>
                <input type="datetime-local" class="input-padrao" id="DataHoraPrimeiroAlerta" name="DataHoraPrimeiroAlerta" required />
            </div>

            <div class="campo">
                <label for="FormaFarmaceutica">Forma Farmacêutica</label>
                <input type="text" class="input-padrao" id="FormaFarmaceutica" name="FormaFarmaceutica" />
            </div>

            <div class="campo">
                <label for="DuracaoEmDias">Duração em Dias</label>
                <input type="number" class="input-padrao" id="DuracaoEmDias" name="DuracaoEmDias" min="1" />
            </div>

            <div class="campo">
                <label for="Observacoes">Observações</label>
                <textarea class="input-padrao" id="Observacoes" name="Observacoes" rows="3"></textarea>
            </div>

            <div class="acoes">
                <button type="submit" class="btn-padrao btn-add">Salvar</button>
            </div>

        </form>

    </div>
</div>

<style>
    body {
        background: #eef7fb;
        font-family: Arial, sans-serif;
    }

    /* Container centralizado */
    .cadastro-container {
        display: flex;
        justify-content: center;
        padding: 40px 20px;
    }

    /* Card do formulário */
    .cadastro-card {
        background: #ffffff;
        padding: 28px 32px;
        border-radius: 14px;
        width: 600px;
        box-shadow: 0 6px 18px rgba(90,159,168,0.15);
        border: 1px solid #e3f2f4;
    }

    /* Título */
    .cadastro-titulo {
        text-align: center;
        color: #5a9fa8;
        font-weight: 600;
        margin-bottom: 20px;
    }

    /* Campos do formulário */
    .campo {
        margin-bottom: 12px;
    }

        .campo label {
            display: block;
            font-size: 14px;
            color: #5a9fa8;
            margin-bottom: 4px;
            font-weight: 500;
        }

    .input-padrao {
        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #a8dadc;
        background: #fafdfe;
        transition: 0.2s;
    }

        .input-padrao:focus {
            outline: none;
            border-color: #5a9fa8;
            box-shadow: 0 0 0 2px rgba(168,218,220,0.3);
        }

    /* Botão principal arredondado */
    .btn-padrao {
        background: #a8dadc;
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 50px;
        cursor: pointer;
        transition: 0.2s;
        font-weight: 500;
    }

        .btn-padrao:hover {
            background: #5a9fa8;
        }

    /* Área de ações centralizada */
    .acoes {
        display: flex;
        justify-content: center;
        margin-top: 15px;
    }
</style>