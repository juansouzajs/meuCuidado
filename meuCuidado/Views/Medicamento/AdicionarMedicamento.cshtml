@model meuCuidado.Dominio.Models.Medicamento
@{
    ViewBag.Title = "Adicionar Medicamento";
}

<div class="cadastro-container">

    <div class="cadastro-card">

        <h2 class="cadastro-titulo">
            💊 Adicionar Medicamento
        </h2>

        @using (Html.BeginForm())
        {
            <div class="form-grid">

                <div class="campo">
                    <label>Nome do medicamento</label>
                    @Html.TextBoxFor(model => model.Nome, new { @class = "input-padrao", placeholder = "Ex: Dipirona" })
                </div>

                <div class="campo">
                    <label>Dosagem</label>
                    @Html.TextBoxFor(model => model.Dosagem, new { @class = "input-padrao", placeholder = "Ex: 500mg" })
                </div>

                <div class="campo">
                    <label>Forma farmacêutica</label>
                    @Html.TextBoxFor(model => model.FormaFarmaceutica, new { @class = "input-padrao", placeholder = "Ex: Comprimido, cápsula..." })
                </div>

                <div class="campo">
                    <label>Duração (dias)</label>
                    @Html.TextBoxFor(model => model.DuracaoEmDias, new
                    {
                        @class = "input-padrao",
                        type = "number",
                        min = "1",
                        placeholder = "Ex: 7"
                    })
                </div>

                <div class="campo campo-full">
                    <label>Observações</label>
                    @Html.TextAreaFor(model => model.Observacoes, new
                    {
                        @class = "input-padrao",
                        rows = "3",
                        placeholder = "Informações adicionais..."
                    })
                </div>

            </div>

            <div class="acoes">

                <a href="@Url.Action("Index")" class="btn-secundario">
                    ← Voltar
                </a>

                <button type="submit" class="btn-padrao btn-salvar">
                    ✔ Salvar Medicamento
                </button>

            </div>
        }

    </div>

</div>


<style>

    body {
        background: linear-gradient(135deg, #eef7fb, #fafdfe);
        font-family: 'Segoe UI', Arial, sans-serif;
    }

    .cadastro-container {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 20px;
    }

    .cadastro-card {

        background: white;
        padding: 30px 35px;
        border-radius: 16px;
        width: 600px;

        box-shadow:
            0 10px 25px rgba(90,159,168,0.12),
            0 2px 6px rgba(0,0,0,0.05);

        border: 1px solid #e3f2f4;

        animation: fadeIn 0.25s ease;
    }

    .cadastro-titulo {

        text-align: center;
        color: #5a9fa8;
        font-weight: 600;
        margin-bottom: 25px;
        font-size: 22px;
    }

    .form-grid {

        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .campo-full {
        grid-column: span 2;
    }

    .campo label {

        display: block;
        font-size: 14px;
        color: #5a9fa8;
        margin-bottom: 5px;
        font-weight: 500;
    }

    .input-padrao {

        width: 100%;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid #cfe8ec;
        background: #fafdfe;
        transition: all 0.2s;
        font-size: 14px;
    }

    .input-padrao:focus {

        outline: none;
        border-color: #5a9fa8;
        background: white;

        box-shadow:
            0 0 0 3px rgba(168,218,220,0.25);
    }

    .acoes {

        margin-top: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-padrao {

        background: linear-gradient(135deg, #a8dadc, #5a9fa8);
        color: white;
        border: none;
        padding: 10px 18px;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 500;
        transition: 0.2s;
        box-shadow: 0 4px 10px rgba(90,159,168,0.2);
    }

    .btn-padrao:hover {

        transform: translateY(-1px);
        box-shadow: 0 6px 14px rgba(90,159,168,0.25);
    }

    .btn-secundario {

        text-decoration: none;
        color: #5a9fa8;
        font-weight: 500;
        transition: 0.2s;
    }

    .btn-secundario:hover {

        color: #3d7f87;
        text-decoration: underline;
    }

    @@keyframes fadeIn {

        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

</style>